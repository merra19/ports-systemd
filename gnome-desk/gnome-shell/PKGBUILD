# description	: Provides core UI functions for the GNOME desktop
# depends	: evolution-data-server gcr4 gjs gnome-desktop ibus mutter
# depends	: polkit startup-notification desktop-file-utils gtk-doc
# depends	: networkmanager power-profiles-daemon bash-completion
# depends	: adwaita-icon-theme dconf elogind libgweather libxml2
# depends	: gnome-control-center blocaled gnome-menus py3-docutils
# depends	: libnma gobject-introspection libsecret pipewire libglvnd
# depends	: py3-gobject

pkgname=gnome-shell
pkgver=49.2
pkgrel=1
url='https://gitlab.gnome.org/GNOME/gnome-shell'
source=(https://download.gnome.org/sources/$pkgname/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D systemd=false \
        -D tests=false \
        build
	ninja -C build
    DESTDIR="$pkgdir" ninja install -C build
}
