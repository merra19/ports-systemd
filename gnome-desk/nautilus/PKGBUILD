# description	: Default file manager for the GNOME desktop
# depends	: bubblewrap gexiv2 gnome-autoar gnome-desktop libadwaita
# depends	: libnotify libportal libseccomp tinysparql exempi libexif
# depends	: gobject-introspection desktop-file-utils py3-gi-docgen
# depends	: gst-plugins-base libcloudproviders adwaita-icon-theme
# depends	: gvfs localsearch

pkgname=nautilus
pkgver=48.3
pkgrel=1
url='https://apps.gnome.org/Nautilus'
source=(https://download.gnome.org/sources/$pkgname/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D docs=true \
        build
	ninja -C build
    DESTDIR="$pkgdir" ninja install -C build
}
