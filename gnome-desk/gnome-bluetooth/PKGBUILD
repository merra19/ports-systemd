# description	: Bluetooth graphical utilities integrated with GNOME
# depends	: gtk4 gsound libnotify upower gobject-introspection
# depends	: libadwaita gtk-doc bluez systemd

pkgname=gnome-bluetooth
pkgver=47.1
pkgrel=1
url='https://gitlab.gnome.org/GNOME/gnome-bluetooth'
source=(https://download.gnome.org/sources/$pkgname/${pkgver%.*}/$pkgname-$pkgver.tar.xz
        https://www.linuxfromscratch.org/patches/blfs/12.4/gnome-bluetooth-47.1-build_fix-1.patch)

build() {
    cd $pkgname-$pkgver

    patch -Np1 -i ../gnome-bluetooth-47.1-build_fix-1.patch

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        build
	ninja -C build
    DESTDIR="$pkgdir" ninja install -C build
}
