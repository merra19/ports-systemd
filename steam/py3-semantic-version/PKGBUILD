# description	: Python library providing a few tools handling SemVer in Python
# depends	: python py3-gpep517 py3-setuptools py3-wheel

pkgname=py3-semantic-version
pkgver=2.10.0
pkgrel=1
url='https://github.com/rbarrois/python-semanticversion'
source=($pkgname-$pkgver.tar.gz::https://github.com/rbarrois/python-semanticversion/archive/$pkgver.tar.gz)

build() {
	cd python-semanticversion-$pkgver

    python3 setup.py build
	python3 setup.py install --skip-build --root="$pkgdir"
}
