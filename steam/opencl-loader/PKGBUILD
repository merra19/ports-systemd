# description	: Official Khronos OpenCL ICD Loader
# depends	: glibc ruby mesa xmlto py3-asciidoc opencl-headers

pkgname=opencl-loader
_pkgname=OpenCL-ICD-Loader
pkgver=2024.10.24
pkgrel=1
url='https://github.com/KhronosGroup/OpenCL-ICD-Loader'
source=($_pkgname-$pkgver.tar.gz::https://github.com/KhronosGroup/OpenCL-ICD-Loader/archive/v${pkgver}.tar.gz)

build() {
    cd "$_pkgname-$pkgver"

	cmake -B build \
        -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release
	make -C build
    make DESTDIR="$pkgdir" install -C build
}
