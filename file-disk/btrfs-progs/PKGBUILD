# description	: Btrfs filesystem utilities
# depends	: glibc lzo lvm2 util-linux zlib python zstd acl
# depends	: linux-api-headers py3-sphinx py3-sphinx_rtd_theme

pkgname=btrfs-progs
pkgver=6.17.1
pkgrel=1
url='https://btrfs.readthedocs.io/en/latest'
source=(https://www.kernel.org/pub/linux/kernel/people/kdave/btrfs-progs/$pkgname-v$pkgver.tar.xz)

build() {
    cd $pkgname-v$pkgver

    ./configure \
        --prefix=/usr \
        --disable-static
    make
    make DESTDIR="$pkgdir" install
}
