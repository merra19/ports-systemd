# description	: User-land utilities for LVM2 (device-mapper) software
# depends	: libaio util-linux readline libnvme mdadm which

pkgname=lvm2
pkgver=2.03.34
pkgrel=1
url='https://sourceware.org/lvm2'
source=($pkgname-$pkgver.tgz::https://sourceware.org/pub/lvm2/LVM2.$pkgver.tgz)
backup=(etc/lvm/lvm.conf etc/lvm/lvmlocal.conf)

build() {
	cd LVM2.$pkgver
	
	PATH=:$PATH:/usr/sbin \
	./configure \
        --prefix=/usr \
		--enable-cmdlib \
		--enable-pkgconfig \
		--enable-udev_sync
	make
	make DESTDIR="$pkgdir" install

	rm -fv "$pkgdir"/usr/lib/udev/rules.d/69-dm-lvm.rules
}
