# description	: Tool to help manage 'well known' user directories
# depends	: bash docbook-xml docbook-xsl-nons libxslt

pkgname=xdg-user-dirs
pkgver=0.19
pkgrel=1
url='https://www.freedesktop.org/wiki/Software/xdg-user-dirs'
source=(https://user-dirs.freedesktop.org/releases/$pkgname-$pkgver.tar.gz)
backup=(etc/xdg/user-dirs.conf etc/xdg/user-dirs.defaults)

build() {
	cd $pkgname-$pkgver

    meson setup \
        --prefix=/usr \
        --buildtype=plain \
        build
    ninja -C build
    DESTDIR="$pkgdir" ninja install -C build

    rm -rvf "$pkgdir"/usr/lib/systemd
}
