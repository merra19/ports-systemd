# description	: Grab images from a Wayland compositor
# depends	: cairo libjpeg-turbo wayland meson pango scdoc
# depends	: wayland-protocols

pkgname=grim
pkgver=1.5.0
pkgrel=1
url='https://gitlab.freedesktop.org/emersion/grim'
source=(https://gitlab.freedesktop.org/emersion/grim/-/archive/v$pkgver/$pkgname-v$pkgver.tar.gz)

build() {
	cd $pkgname-v$pkgver

    meson setup \
        --prefix=/usr \
        --buildtype=plain \
		-D bash-completions=true \
		-D fish-completions=true \
        build
    ninja -C build
    DESTDIR="$pkgdir" ninja install -C build
}