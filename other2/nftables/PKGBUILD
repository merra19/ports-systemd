# description	: Linux kernel firewall, NAT and packet mangling tools
# depends	: glibc libmnl libnftnl libgmp jansson python pkgconf
# depends	: readline iptables flex py3-asciidoc

pkgname=nftables
pkgver=1.1.6
pkgrel=1
url='https://netfilter.org/projects/nftables'
source=(https://netfilter.org/projects/${pkgname}/files/$pkgname-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --sysconfdir=/etc \
        --with-json \
        --with-cli=readline \
        --disable-python \
        --disable-debug
    make
    make DESTDIR="$pkgdir" install
}
