# description	: youtube-dl fork with additional features and fixe
# depends	: py3-gpep517 py3-hatchling attr ffmpeg brotli py3-certifi
# depends	: py3-requests py3-urllib3 py3-installer py3-brotlicffi
# depends	: py3-pycryptodome 

pkgname=yt-dlp
pkgver=2025.12.08
pkgrel=1
url='https://github.com/yt-dlp/yt-dlp'
source=($pkgname-$pkgver.tar.gz::https://github.com/yt-dlp/yt-dlp/releases/download/$pkgver/yt-dlp.tar.gz)

build() {
    cd $pkgname

    gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d "$pkgdir" .dist/*.whl

    ln -sfv yt-dlp "$pkgdir"/usr/bin/youtube-dl
}
