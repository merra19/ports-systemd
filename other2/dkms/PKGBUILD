# description	: Dynamic Kernel Modules System
# depends	: bash kmod make patch

pkgname=dkms
pkgver=3.3.0
pkgrel=1
url=' https://github.com/dell/dkms'
source=($pkgname-$pkgver.tar.gz::https://github.com/dell/dkms/archive/v$pkgver.tar.gz
        buildmodules-template.sh)
backup=(etc/dkms/framework.conf)

build() {
    cd $pkgname-$pkgver

	make DESTDIR="$pkgdir" install

	mkdir -pv "$pkgdir"/usr/lib/dkms
	install -m644 "$srcdir"/buildmodules-template.sh "$pkgdir"/usr/lib/dkms/
}
