# description	: Foreign Function Interface for Python calling C code
# depends	: py3-flit-core py3-gpep517 py3-setuptools py3-pycparser

pkgname=py3-cffi
pkgver=2.0.0
pkgrel=1
url='https://cffi.readthedocs.io'
source=(https://files.pythonhosted.org/packages/source/c/cffi/cffi-$pkgver.tar.gz)

build() {
	cd ${pkgname#*-}-$pkgver

    gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d "$pkgdir" .dist/*.whl
}
