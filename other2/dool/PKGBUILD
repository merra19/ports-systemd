# description	: Versatile replacement for vmstat, iostat and ifstat (clone of dstat)
# depends	: python py3-six

pkgname=dool
pkgver=1.3.2
pkgrel=3
url='http://dag.wieers.com/home-made/dstat'
source=($pkgname-$pkgver.tar.gz::https://github.com/scottchiefbaker/dool/archive/refs/tags/v${pkgver}.tar.gz
        dool-1.3.2-add-site-packages-dir-to-plugin-path.patch::https://github.com/scottchiefbaker/dool/pull/80/commits/5c538542a5bf2b16c496ab9d0a15f439f1ba1e49.patch)

build() {
    cd $pkgname-$pkgver

    mv dool dool.py

    patch -Np2 -i "$srcdir"/dool-1.3.2-add-site-packages-dir-to-plugin-path.patch

	mkdir dool
	mv plugins dool
	mv dool.py dool

	cat <<-EOF > dool/__init__.py
	"""Versatile replacement for vmstat, iostat and ifstat (clone of dstat)"""
	__version__ = "${pkgver}"
	EOF

	sed -i 's/dool:__main/dool.dool:__main/' pyproject.toml

    gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d "$pkgdir" .dist/*.whl
}
