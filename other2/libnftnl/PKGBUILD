# description	:Netlink API to the in-kernel nf_tables subsystem
# depends	: glibc libmnl pkgconf

pkgname=libnftnl
pkgver=1.3.1
pkgrel=1
url='https://netfilter.org/projects/nftables'
source=(https://netfilter.org/projects/${pkgname}/files/$pkgname-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver

	./configure \
        --prefix=/usr
    make
    make DESTDIR="$pkgdir" install
}
