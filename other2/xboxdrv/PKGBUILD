# description	: Userspace Xbox 360 Controller driver
# depends	: python py3-dbus libusb xorg-libs glib meson

pkgname=xboxdrv
pkgver=0.8.14
pkgrel=1
options=(!lto)
commit=a7be45051b2c920d6dfec4d0c515c815883bdaff
url='https://github.com/xiota/xboxdrv'
source=($pkgname-$pkgver.tar.gz::https://github.com/xiota/xboxdrv/archive/$commit.tar.gz
		xboxdrv.init xboxdrv.conf)
backup=(etc/default/xboxdrv etc/xboxdrv.conf)

build() {
    cd $pkgname-$commit

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        build
	ninja -C build
    DESTDIR="$pkgdir" ninja install -C build

	rm -rf "$pkgdir"/usr/lib/systemd

	install -d "$pkgdir"/etc/dbus-1/system.d/
	install -m 644 data/org.seul.Xboxdrv.conf "$pkgdir"/etc/dbus-1/system.d/

    install -d "$pkgdir"/etc/modules-load.d
    echo "uinput" > "$pkgdir"/etc/modules-load.d/uinput.conf

	install -Dm 0754 "$srcdir"/xboxdrv.init "$pkgdir"/etc/rc.d/init.d/xboxdrv
	install -Dm 0644 "$srcdir"/xboxdrv.conf "$pkgdir"/etc/xboxdrv.conf
}
