# description	: Python module to propose a modern general-purpose parsing library for Python
# depends	: py3-flit-core py3-gpep517 py3-setuptools 
# depends	: py3-typing_extensions

pkgname=py3-lark-parser
pkgver=1.3.1
pkgrel=1
source=($pkgname-$pkgver.tar.gz::https://github.com/lark-parser/lark/archive/$pkgver.tar.gz)

build() {
	cd lark-$pkgver

    gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d "$pkgdir" .dist/*.whl
}