# description	: Modem and mobile broadband management libraries
# depends	: libgudev glib elogind gobject-introspection libqmi 
# depends	: libmbim polkit vala gtk-doc

pkgname=modemmanager
_pkgname=ModemManager
pkgver=1.24.2
pkgrel=2
url='https://www.freedesktop.org/wiki/Software/ModemManager'
source=(https://gitlab.freedesktop.org/mobile-broadband/ModemManager/-/archive/$pkgver/ModemManager-$pkgver.tar.gz)

build() {
	cd $_pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D man=false  \
        -D qrtr=false \
		-D gtk_doc=true \
		-D systemdsystemunitdir=no \
        build
	ninja -C build
    DESTDIR="$pkgdir" ninja install -C build
}
