# description	: A message bus system, a simple way for applications to talk to each other
# depends	: expat xorg-proto xorg-libs

pkgname=dbus
pkgver=1.16.2
pkgrel=1
options=(!lto)
url='https://www.freedesktop.org/wiki/Software/dbus'
source=(https://dbus.freedesktop.org/releases/dbus/$pkgname-$pkgver.tar.xz
        malloc_trim.patch memory.patch dbus)

build() {
    cd $pkgname-$pkgver

    patch -Np1 -i ../malloc_trim.patch
    patch -Np1 -i ../memory.patch

    meson setup \
        --prefix=/usr \
        --buildtype=plain \
        --wrap-mode=nofallback \
		-D systemd=disabled \
        p11-build 
    ninja -C p11-build 
    DESTDIR=${pkgdir} ninja install -C p11-build
   
    chown -v root:messagebus "$pkgdir"/usr/libexec/dbus-daemon-launch-helper &&
    chmod -v      4750       "$pkgdir"/usr/libexec/dbus-daemon-launch-helper

    ln -sfv /var/lib/dbus/machine-id  "$pkgdir"/etc/

	mv -v  "$pkgdir"/usr/share/doc/dbus{,-$pkgver}

	install -Dm 0754 "$srcdir"/dbus "$pkgdir"/etc/rc.d/init.d/dbus

    for i in 0 1 2 3 4 5 6; do
        install -d "$pkgdir"/etc/rc.d/rc$i.d
        case $i in
            0|1|6) ln -sf ../init.d/dbus "$pkgdir"/etc/rc.d/rc$i.d/K30dbus ;;
            *) ln -sf ../init.d/dbus "$pkgdir"/etc/rc.d/rc$i.d/S29dbus ;;
        esac
    done

    rm -rf "$pkgdir"/run
}
