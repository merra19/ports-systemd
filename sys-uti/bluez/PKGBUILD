# description	: Bluetooth Tools and System Daemons for Linux
# depends	: dbus glib libical py3-docutils readline udev

pkgname=bluez
pkgver=5.83
pkgrel=1
options=(!lto)
url='https://www.bluez.org'
source=(https://www.kernel.org/pub/linux/bluetooth/$pkgname-$pkgver.tar.xz
        rfcomm.conf uart.conf bluetooth bluesysconfig)
backup=(etc/bluetooth/main.conf)

build() {
	cd $pkgname-$pkgver

	./configure \
        --prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--enable-library \
		--enable-manpages \
		--disable-systemd
	make
	make DESTDIR="$pkgdir" install

	install -d "$pkgdir"/usr/sbin
	ln -svf ../libexec/bluetooth/bluetoothd "$pkgdir"/usr/sbin

	install -v -dm755 "$pkgdir"/etc/bluetooth &&
	install -v -m644 src/main.conf "$pkgdir"/etc/bluetooth/main.conf

	install  -Dm644 ../rfcomm.conf "$pkgdir"/etc/bluetooth/rfcomm.conf
	install  -Dm644 ../uart.conf "$pkgdir"/etc/bluetooth/uart.conf

    install -v -dm755 "$pkgdir"/usr/share/doc/$pkgname-$pkgver
    install -v -m644 doc/*.txt "$pkgdir"/usr/share/doc/$pkgname-$pkgver

	install -d "$pkgdir"/usr/share/dbus-1/services
	install -m644 ./obexd/src/org.bluez.obex.service "$pkgdir"/usr/share/dbus-1/services

    # conflict with bluez-headers
    rm -rf "$pkgdir"/usr/include/bluetooth

	install -Dm 0754 "$srcdir"/bluetooth "$pkgdir"/etc/rc.d/init.d/bluetooth

    install -Dm 0644 "$srcdir"/bluesysconfig "$pkgdir"/etc/sysconfig/bluetooth

    for i in 0 1 2 3 4 5 6; do
        install -d "$pkgdir"/etc/rc.d/rc$i.d
        case $i in
            0|1|6) ln -sf ../init.d/bluetooth "$pkgdir"/etc/rc.d/rc$i.d/K27bluetooth ;;
            *) ln -sf ../init.d/bluetooth "$pkgdir"/etc/rc.d/rc$i.d/S35bluetooth ;;
        esac
    done
}
