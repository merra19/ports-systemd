# description	: Simulate keyboard input and mouse activity, move and resize windows
# depends	: glibc xorg-libs

pkgname=xdotool
pkgver=4.20251130.1
pkgrel=1
url='https://www.semicomplete.com/projects/xdotool'
source=(https://github.com/jordansissel/xdotool/releases/download/v3.20211022.1/xdotool-3.20211022.1.tar.gz)

build() {
    cd $pkgname-$pkgver

    # First, fix an invalid path in an installed pkg-config file
    sed -i 's#/local##' libxdo.pc

    make WITHOUT_RPATH_FIX=1   
    make DESTDIR="$pkgdir" PREFIX=/usr INSTALLMAN=/usr/share/man install
}
