# description	: analog / digital clock for X
# depends	: xorg-libs

pkgname=xclock
pkgver=1.1.1
pkgrel=1
url='https://www.x.org/wiki'
source=(https://www.x.org/pub/individual/app/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static 
    make
    make DESTDIR="$pkgdir" install
}
