# description	: Python docutils-compatibility bridge to CommonMark
# depends	: python py3-gpep517 py3-setuptools py3-wheel
# depends	: py3-sphinx py3-commonmark

pkgname=py3-recommonmark
pkgver=0.7.1
pkgrel=1
options=(!lto)
url='https://pypi.org/project/commonmark'
source=(https://files.pythonhosted.org/packages/source/r/recommonmark/recommonmark-$pkgver.tar.gz)

build() {
	cd ${pkgname#*-}-$pkgver

    gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d "$pkgdir" .dist/*.whl
}