# description	: Canonical source for classifiers on PyPI (pypi.org)
# depends	: python py3-gpep517 py3-setuptools py3-wheel 
# depends	: py3-calver

pkgname=py3-trove-classifiers
_pkgname=trove_classifiers
pkgver=2025.11.14.15
pkgrel=1
url='https://github.com/pypa/trove-classifiers'
source=(https://github.com/pypa/trove-classifiers/archive/$pkgver/py3-trove-classifiers-$pkgver.tar.gz)

build() {
	cd ${pkgname#*-}-$pkgver
    
    #echo "Version: $pkgver" > PKG-INFO

    sed -i '/calver/s/^/#/;$iversion="2025.11.14.15"' setup.py

    gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d "$pkgdir" .dist/trove_classifiers-$pkgver-py3-none-any.whl
}
