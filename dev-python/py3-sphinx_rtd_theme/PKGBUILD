# description	: ReadTheDocs.org theme for Sphinx
# depends	: python py3-gpep517 py3-setuptools py3-wheel 
# depends	: py3-sphinx  py3-sphinxcontrib-jquery

pkgname=py3-sphinx_rtd_theme
pkgver=3.0.2
pkgrel=1
options=(!lto)
url='https://github.com/readthedocs/sphinx_rtd_theme'
source=(https://files.pythonhosted.org/packages/source/s/sphinx_rtd_theme/sphinx_rtd_theme-$pkgver.tar.gz)

build() {
	cd ${pkgname#*-}-$pkgver

    gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d "$pkgdir" .dist/*.whl
}
