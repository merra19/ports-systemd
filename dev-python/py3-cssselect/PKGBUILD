# description	: Parse CSS3 Selectors and translate them to XPath 1.0
# depends	: python py3-gpep517 py3-setuptools py3-wheel py3-six
# depends	:py3-setuptools-scm

pkgname=py3-cssselect
pkgver=1.3.0
pkgrel=1
url='https://cssselect.readthedocs.io/en/latest'
source=(https://files.pythonhosted.org/packages/source/c/cssselect/cssselect-$pkgver.tar.gz)

build() {
	cd cssselect-$pkgver

    gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d "$pkgdir" .dist/*.whl
}
