# description	: A thumbnail service for Thunar
# depends	: glib freetype libpng gdk-pixbuf curl libjpeg-turbo 
# depends	: poppler intltool gettext pkgconf libgsf gtk-doc
# depends	: gst-libav gst-plugins-bad gst-plugins-good
# depends	: gst-plugins-ugly

pkgname=tumbler
pkgver=4.20.1
pkgrel=1
options=(!lto)
url='https://docs.xfce.org/xfce/tumbler/start'
source=(https://archive.xfce.org/src/xfce/tumbler/${pkgver%.*}/$pkgname-$pkgver.tar.bz2)

build() {
	cd $pkgname-$pkgver

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc
    make
	make DESTDIR="$pkgdir" install
}
