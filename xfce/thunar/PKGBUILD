# description	: File manager for the Xfce desktop environment
# depends	: exo hicolor-icon-theme libgudev libnotify pcre2 libexif  
# depends	: tumbler gvfs gtk-doc udev

pkgname=thunar
pkgver=4.20.6
pkgrel=1
url='https://docs.xfce.org/xfce/thunar/start'
source=(https://archive.xfce.org/src/xfce/thunar/${pkgver%.*}/$pkgname-$pkgver.tar.bz2)

build() {
	cd $pkgname-$pkgver

	# First prevent the installation of an unneeded systemd file
	sed -i 's/\tinstall-systemd_userDATA/\t/' Makefile.in

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --docdir=/usr/share/doc/$pkgname-$pkgver
    make
    make DESTDIR="$pkgdir" install
}
