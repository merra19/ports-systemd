# description	: A library for registering global keyboard shortcuts
# depends	: gtk3 gobject-introspection gtk-doc

pkgname=keybinder-3.0
pkgver=0.3.2
pkgrel=2
url='https://github.com/kupferlauncher/keybinder'
source=(https://github.com/kupferlauncher/keybinder/releases/download/keybinder-3.0-v$pkgver/$pkgname-$pkgver.tar.gz)

build() {
    cd $pkgname-$pkgver

    ./configure \
        --prefix=/usr \
        --disable-lua \
		--enable-gtk-do
    make
    make DESTDIR="$pkgdir" install
}
