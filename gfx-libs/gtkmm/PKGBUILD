# description	: C++ interface for GTK+
# depends	: gtk4 pangomm vulkan-loader

pkgname=gtkmm
pkgver=4.20.0
pkgrel=1
url='https://gtkmm.gnome.org/en/index.html'
source=(https://download.gnome.org/sources/gtkmm/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        gtkmm4-build
	ninja -C gtkmm4-build
    DESTDIR="$pkgdir" ninja install -C gtkmm4-build

    mv -v "$pkgdir"/usr/share/doc/gtkmm-4.0 "$pkgdir"/usr/share/doc/gtkmm-$pkgver
}
