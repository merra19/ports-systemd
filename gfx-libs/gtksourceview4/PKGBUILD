# description	: A text widget implementing syntax highlighting and other features
# depends	: gtk3 gobject-introspection libxml2 vala glib itstool
# depends	: gtk-doc

pkgname=gtksourceview4
pkgver=4.8.4
pkgrel=3
url='https://wiki.gnome.org/Projects/GtkSourceView'
source=(https://download.gnome.org/sources/gtksourceview/${pkgver%.*}/gtksourceview-${pkgver}.tar.xz)

build() {
    cd gtksourceview-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
		-D gtk_doc=true \
        build
	ninja -C build
    DESTDIR="$pkgdir" ninja install -C build

	# add *.ebuild to shell highlightning
	sed -i 's/.bash_profile/.bash_profile;*.ebuild;PKGBUILD/' "$pkgdir"/usr/share/gtksourceview-4/language-specs/sh.lang
}
