# description	: A thin layer of types for graphic libraries
# depends	: gobject-introspection glib meson gtk-doc

pkgname=graphene
pkgver=1.10.8
pkgrel=2
url='https://ebassi.github.io/graphene'
source=(https://download.gnome.org/sources/graphene/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
		-D gtk_doc=true \
        build
	ninja -C build
    DESTDIR="$pkgdir" ninja install -C build
}
