# description	: D-Bus accessibility specifications and registration daemon
# depends	: dbus glib gobject-introspection xorg-libs
# depends	: gsettings-desktop-schemas py3-sphinx

pkgname=at-spi2-core
pkgver=2.58.2
pkgrel=1
url='https://gitlab.gnome.org/GNOME/at-spi2-core'
source=(https://download.gnome.org/sources/at-spi2-core/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D gtk2_atk_adaptor=false \
		-D docs=true \
		-D systemd_user_dir=/tmp \
        build
	ninja -C build
	DESTDIR="$pkgdir" ninja install -C build

	rm -rf "$pkgdir"/tmp
}
