# description	: Vulkan Header files and API registry
# depends	: cmake

pkgname=vulkan-headers
pkgver=1.4.335.0
pkgrel=1
url='https://github.com/KhronosGroup/Vulkan-Headers'
source=(https://github.com/KhronosGroup/Vulkan-Headers/archive/vulkan-sdk-$pkgver/Vulkan-Headers-vulkan-sdk-$pkgver.tar.gz)

build() {
    cd Vulkan-Headers-vulkan-sdk-$pkgver

    cmake -B build \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_BUILD_TYPE=Release \
        -G Ninja
    ninja -C build
    DESTDIR="$pkgdir" ninja  install -C build
}
