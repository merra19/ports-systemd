# description	: A library for the X Keyboard Extension (high-level API)
# depends	: iso-codes glib libxml2 gobject-introspection xorg-libs
# depends	: gtk-doc

pkgname=libxklavier
pkgver=5.4
pkgrel=2
url='https://www.freedesktop.org/wiki/Software/LibXklavier'
source=(https://people.freedesktop.org/~svu/$pkgname-$pkgver.tar.bz2)

build() {
    cd $pkgname-$pkgver

    ./configure \
        --prefix=/usr \
        --disable-static
    make
    make DESTDIR="$pkgdir" install
}
