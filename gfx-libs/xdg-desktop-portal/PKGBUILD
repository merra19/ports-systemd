# description	: Desktop integration portal
# depends	: json-glib wireplumber pipewire fuse gdk-pixbuf geoclue
# depends	: bubblewrap dbus libportal gstreamer py3-sphinx
# depends	: gst-plugins-base py3-docutils

pkgname=xdg-desktop-portal
pkgver=1.20.3
pkgrel=1
options=(!lto)
url='https://flatpak.github.io/xdg-desktop-portal'
source=(https://github.com/flatpak/xdg-desktop-portal/releases/download/$pkgver/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D tests=disabled \
        build
	ninja -C build
	DESTDIR="$pkgdir" ninja install -C build

	rm -rvf "$pkgdir"/usr/lib/systemd
}
