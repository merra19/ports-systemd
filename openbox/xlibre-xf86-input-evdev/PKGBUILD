# description	: Generic Linux input driver
# depends	: libevdev xlibre-xserver mtdev xorg-proto udev
# depends	: linux-api-headers

pkgname=xlibre-xf86-input-evdev
pkgver=25.0.0
pkgrel=1
options=(!makeflags)
url='https://x11libre.net'
source=(https://github.com/X11Libre/xf86-input-evdev/archive/refs/tags/$pkgname-$pkgver.tar.gz)

build() {
    cd xf86-input-evdev-xlibre-xf86-input-evdev-$pkgver

    LDFLAGS="$LDFLAGS -Wl,-z,lazy $DEBUGFLAGS"
    export LDFLAGS

    autoreconf -fiv
    
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static
    make -j1
    make DESTDIR="$pkgdir" install
}
