# description	: An open-source memory debugger for GNU/Linux
# depends	: libaio docbook-xml libxslt

pkgname=valgrind
pkgver=3.26.0
pkgrel=1
options=(!lto) 
url='https://valgrind.org'
source=(https://sourceware.org/pub/valgrind/$pkgname-$pkgver.tar.bz2
        valgrind-3.7.0-respect-flags.patch)

build() {
	cd $pkgname-$pkgver

    patch -Np1 < ../valgrind-3.7.0-respect-flags.patch

    sed -i 's|/doc/valgrind||' docs/Makefile.in

    CC=gcc
    CXX=g++
    export CC CXX

    export CFLAGS=`echo $CFLAGS | sed s,-fexceptions,,g | sed s:-Wp,-D_FORTIFY_SOURCE=2::g | sed s:-fstack-protector::g `
    export CFLAGS="$CFLAGS -O2 -fno-stack-protector"
    export CXXFLAGS="-O2 -fno-stack-protector"
    ./autogen.sh

    export CFLAGS=" -O2 -g -Wp,-D_FORTIFY_SOURCE=2 -fexceptions  --param=ssp-buffer-size=32 -Wformat -Wformat-security -Wno-error -Wl,-z,max-page-size=0x4000 -march=$MMARCH -fno-lto -g1"
    export CXXFLAGS="$CFLAGS"


    ./configure \
        --prefix=/usr \
        --datadir=/usr/share/doc/$pkgname-$pkgver
    make
    make DESTDIR="$pkgdir" install
}
