# description	: The Boehm-Demers-Weiser conservative garbage collector
# depends	: glibc libatomic_ops

pkgname=gc
pkgver=8.2.10
pkgrel=1
url='https://www.hboehm.info/gc'
source=(https://github.com/ivmai/bdwgc/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz
        https://www.linuxfromscratch.org/patches/blfs/svn/gc-8.2.10-fork_workaround-1.patch)

build() {
	cd $pkgname-$pkgver

    # Apply a patch to fix crashes in applications using GC and 
    # another library forking subprocesses
    patch -Np1 -i ../gc-8.2.10-fork_workaround-1.patch

	./configure \
		--prefix=/usr \
		--enable-cplusplus \
		--disable-static \
		--docdir=/usr/share/doc/$pkgname-$pkgver
	make
	make DESTDIR="$pkgdir" install
	
	install -v -Dm644 doc/gc.man "$pkgdir"/usr/share/man/man3/gc_malloc.3
}
