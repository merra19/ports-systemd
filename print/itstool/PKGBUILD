# description	: Translation tool for XML documents that uses gettext files and ITS rules
# depends	: docbook-xml python

pkgname=itstool
pkgver=2.0.7
pkgrel=2
options=(!lto)
url='https://itstool.org'
source=(https://github.com/itstool/itstool/archive/$pkgver/$pkgname-$pkgver.tar.gz
        https://www.linuxfromscratch.org/patches/blfs/svn/itstool-2.0.7-lxml-1.patch)

build() {
    cd $pkgname-$pkgver

    # Apply a patch to use lxml-6.0.2 for handling the XML files instead of the deprecated 
    # (disabled by default) Python module from libxml2-2.15.1
    patch -Np1 -i ../itstool-2.0.7-lxml-1.patch

    PYTHON=/usr/bin/python3 ./autogen.sh --prefix=/usr &&
    make
    make DESTDIR="$pkgdir" install
}
