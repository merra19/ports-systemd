# description	: View images
# depends	: glycin lcms2 libadwaita libgweather libseccomp rustc
# depends	: appstream

pkgname=loupe
pkgver=49.1
pkgrel=1
url='https://apps.gnome.org/Loupe'
source=(https://download.gnome.org/sources/$pkgname/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        build
	ninja -C build
    DESTDIR="$pkgdir" ninja install -C build
}