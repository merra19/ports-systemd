# description	: Automatic archives creating and extracting library
# depends	: gtk4 itstool cpio desktop-file-utils json-glib nautilus
# depends	: libarchive libadwaita libportal py3-gi-docgen unrar zip

pkgname=file-roller
pkgver=44.5
pkgrel=1
url='https://gitlab.gnome.org/GNOME/file-roller'
source=(https://download.gnome.org/sources/$pkgname/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D packagekit=false \
        -D api_docs=disabled \
        build
	ninja -C build
    DESTDIR="$pkgdir" ninja install -C build

    chmod -v 0755 "$pkgdir"/usr/libexec/file-roller/isoinfo.sh
}
