# description	: GNOME color profile tools
# depends	: colord gtk3 lcms2 desktop-file-utils itstool
# depends	: docbook-utils

pkgname=gnome-color-manager
pkgver=3.36.2
pkgrel=1
url='https://gitlab.gnome.org/GNOME/gnome-color-manager'
source=(https://download.gnome.org/sources/$pkgname/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver

    # If DocBook-utils-0.6.14 is installed, disable installation of 
    # the man pages to avoid a build failure
    sed /subdir\(\'man/d -i meson.build

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        build
	ninja -C build
    DESTDIR="$pkgdir" ninja install -C build
}
