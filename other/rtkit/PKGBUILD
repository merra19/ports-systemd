# description	: Realtime Policy and Watchdog Daemon
# depends	: dbus polkit meson

pkgname=rtkit
pkgver=0.14
pkgrel=1
url='https://github.com/heftig/rtkit'
source=(https://gitlab.freedesktop.org/pipewire/rtkit/-/archive/v${pkgver}/$pkgname-v${pkgver}.tar.bz2
        $pkgname.hooks)

build() {
	cd $pkgname-v${pkgver}

    meson setup \
        --prefix=/usr \
        --buildtype=plain \
		-D installed_tests=false \
		-D libsystemd=disabled \
        build
    ninja -C build
    DESTDIR="$pkgdir" ninja install -C build

	rm -rf "$pkgdir"/usr/lib/systemd

	install -Dm755 "$srcdir"/$pkgname.hooks "$pkgdir"/usr/share/blfs-bootscripts/hooks/$pkgname.hooks
}
