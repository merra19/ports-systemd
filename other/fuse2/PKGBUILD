# description	: An interface for filesystems implemented in userspace
# depends	: glibc pkgconf

pkgname=fuse2
pkgver=2.9.9
pkgrel=3
optios=(!lto)
url='https://github.com/libfuse/libfuse'
source=(https://github.com/libfuse/libfuse/releases/download/fuse-$pkgver/fuse-$pkgver.tar.gz
        fuse-2.9.3-kernel-types.patch fuse-2.9.9-avoid-calling-umount.patch
		fuse-2.9.9-closefrom-glibc-2-34.patch)

build() {
	cd fuse-$pkgver

	patch -Np1 -i ../fuse-2.9.3-kernel-types.patch
	patch -Np1 -i ../fuse-2.9.9-avoid-calling-umount.patch
	patch -Np1 -i ../fuse-2.9.9-closefrom-glibc-2-34.patch

	autoreconf -vfi  -I /usr/share/gettext/m4

    UDEV_RULES_PATH=/usr/lib/udev/rules.d MOUNT_FUSE_PATH=/usr/bin \
	./configure \
		--prefix=/usr \
		--libdir=/usr/lib \
		--enable-lib \
		--enable-util \
		--disable-static \
		--disable-example
    make
    make DESTDIR="${pkgdir}" install

    # Remove init script in wrong path
    # Don't add our own for now, as fusectl fs oopses on 2.6.18
    rm -r "${pkgdir}"/etc/init.d

    # static device nodes are handled by udev
    rm -r "${pkgdir}"/dev
}
