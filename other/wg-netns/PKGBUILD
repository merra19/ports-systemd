# description	: A simple Python script that implements the steps described at wireguard.com/netns
# depends	: wireguard-tools python iproute2 py3-yaml

pkgname=wg-netns
pkgver=1
pkgrel=1
url='https://github.com/dadevel/wg-netns'
source=(wg-netns jfree.yaml wg-netns.init wg-firefox)

build() {
	install -Dm 755 wg-netns  "$pkgdir"/usr/bin/wg-netns
	install -Dm 644 jfree.yaml "$pkgdir"/usr/share/wg-netns/jfree.yaml
	install -Dm 755 wg-firefox  "$pkgdir"/usr/local/bin/wg-firefox
}
