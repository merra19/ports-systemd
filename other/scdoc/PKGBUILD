# description	: Standalone tool for generating man pages with a simple syntax
# depends	: glibc

pkgname=scdoc
pkgver=1.11.3
pkgrel=1
url='https://git.sr.ht/~sircmpwn/scdoc'
source=($pkgname-$pkgver.tar.gz::https://git.sr.ht/~sircmpwn/scdoc/archive/$pkgver.tar.gz)

build() {
	cd $pkgname-$pkgver

	make PREFIX="/usr" LDFLAGS="$LDFLAGS"
    make DESTDIR="$pkgdir" PREFIX="/usr" install
 }