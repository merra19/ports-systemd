# description	: Simple library to speed up or slow down speech
# depends	: glibc

pkgname=libsonic
pkgver=0.2.0_p20250419
pkgrel=1
commit=fda30fba867c08c82dbbecbcc72120652e40d5cb
source=($pkgname-$pkgver.tar.gz::https://github.com/waywardgeek/sonic/archive/$commit.tar.gz )

build() {
    cd sonic-$commit

    make
    make DESTDIR="$pkgdir" install
    rm -v "$pkgdir/usr/lib/libsonic.a"
    install -vDm644 sonic.1 -t "$pkgdir/usr/share/man/man1/"
}