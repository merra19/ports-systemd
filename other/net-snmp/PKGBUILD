# description	: Software for generating and retrieving SNMP data
# depends	: glibc bzip2 elfutils lm-sensors pciutils perl zlib
# depends	: py3-setuptools pcre2 openssl libpcap

pkgname=net-snmp
pkgver=5.9.5.2
pkgrel=1
options=(!emptydirs !makeflags !lto)
url='https://www.net-snmp.org'
source=(https://downloads.sourceforge.net/$pkgname/$pkgname/$pkgver/$pkgname-$pkgver.tar.gz
		net-snmp-5.8-pcap.patch 
		net-snmp-5.8.1-mysqlclient.patch
		net-snmp-5.9-MakeMaker.patch
		net-snmp-5.9.3-0001-Fix-LDFLAGS-vs-LIBS-ordering.patch
		net-snmp-5.9.3-0002-Tidy-up-net-snmp-config-output.patch
		net-snmp-5.9.3-0003-Prune-Libs.private-entries-in-netsnmp-.pc.in.patch
		net-snmp-5.9.3-0004-Search-for-ltinfo-in-configure-if-needed.patch
		net-snmp-5.9.4-c99.patch
		d3e95c87b32397815f6d5bcfc844259f2552697a.patch
		346b6f8959513320e5b674fd670c49ba2cd43af5.patch
		e5aadf1e78c624a8e4147d4b70a7795497a50e73.patch
		7fc7edf676c527a0cfb661f9000a3d22738cf8e6.patch
		snmpd.init snmptrapd.init snmpd.conf snmptrapd.conf)
backup=(etc/snmpd.conf etc/snmptrapd.conf)

build() {
	cd $pkgname-$pkgver

	patch -Np1 -i ../net-snmp-5.8-pcap.patch
	patch -Np1 -i ../net-snmp-5.8.1-mysqlclient.patch
	patch -Np1 -i ../net-snmp-5.9-MakeMaker.patch
	patch -Np1 -i ../net-snmp-5.9.3-0001-Fix-LDFLAGS-vs-LIBS-ordering.patch
	patch -Np1 -i ../net-snmp-5.9.3-0002-Tidy-up-net-snmp-config-output.patch
	patch -Np1 -i ../net-snmp-5.9.3-0003-Prune-Libs.private-entries-in-netsnmp-.pc.in.patch
	patch -Np1 -i ../net-snmp-5.9.3-0004-Search-for-ltinfo-in-configure-if-needed.patch
	#patch -Np1 -i ../net-snmp-5.9.4-c99.patch

	# pcre2 , Linux 6.7 compatibility parsing /proc/net/snmp
	patch -Np1 -i ../d3e95c87b32397815f6d5bcfc844259f2552697a.patch
	patch -Np1 -i ../346b6f8959513320e5b674fd670c49ba2cd43af5.patch
	patch -Np1 -i ../e5aadf1e78c624a8e4147d4b70a7795497a50e73.patch
	#patch -Np1 -i ../7fc7edf676c527a0cfb661f9000a3d22738cf8e6.patch

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--enable-blumenthal-aes \
		--enable-ipv6 \
		--enable-ucd-snmp-compatibility \
		--with-python-modules \
		--with-default-snmp-version=3 \
		--with-sys-contact='root@localhost' \
		--with-sys-location='Unknown' \
		--with-logfile='/var/log/snmpd.log' \
		--with-mib-modules='host misc/ipfwacc ucd-snmp/diskio tunnel ucd-snmp/dlmod ucd-snmp/lmsensorsMib' \
		--with-persistent-directory='/var/lib/net-snmp'
	make NETSNMP_DONT_CHECK_VERSION=1

	sed -i -e "s:install --basedir=\$\$dir:install --basedir=\$\$dir --root=${pkgdir}:" Makefile
	make DESTDIR="$pkgdir" INSTALL_PREFIX="$pkgdir" INSTALLDIRS=vendor install

	install -Dm 0754 "$srcdir"/snmpd.init "$pkgdir"/etc/rc.d/init.d/snmpd
	install -Dm 0754 "$srcdir"/snmpd.conf "$pkgdir"/etc/snmpd.conf

    for i in 0 1 2 3 4 5 6; do
        install -d "$pkgdir"/etc/rc.d/rc$i.d
        case $i in
            0|1|6) ln -sf ../init.d/snmpd "$pkgdir"/etc/rc.d/rc$i.d/K26snmpd ;;
            *) ln -sf ../init.d/snmpd "$pkgdir"/etc/rc.d/rc$i.d/S74snmpd ;;
        esac
    done

	install -Dm 0754 "$srcdir"/snmptrapd.init "$pkgdir"/etc/rc.d/init.d/snmptrapd
	install -Dm 0754 "$srcdir"/snmptrapd.conf "$pkgdir"/etc/snmptrapd.conf

    for i in 0 1 2 3 4 5 6; do
        install -d "$pkgdir"/etc/rc.d/rc$i.d
        case $i in
            0|1|6) ln -sf ../init.d/snmptrapd "$pkgdir"/etc/rc.d/rc$i.d/K25snmpdtrapd ;;
            *) ln -sf ../init.d/snmptrapd "$pkgdir"/etc/rc.d/rc$i.d/S76snmpdtrapd ;;
        esac
    done
}
