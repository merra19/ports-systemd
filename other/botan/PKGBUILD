# description	: C++ crypto library
# depends	: sqlite xz python zlib bzip2 ninja boost py3-sphinx

pkgname=botan
_pkgname=Botan
pkgver=3.9.0
pkgrel=2
url='https://botan.randombit.net'
source=(https://botan.randombit.net/releases/Botan-$pkgver.tar.xz)

build() {
    cd ${_pkgname}-$pkgver

    ./configure.py \
        --prefix=/usr \
        --with-bzip \
        --with-lzma \
        --with-zlib \
        --without-boost \
        --with-sqlite3 \
		--with-documentation \
		--with-sphinx \
        --disable-static-library \
        --with-os-feature=getrandom
    make
    make DESTDIR="$pkgdir" install
}
