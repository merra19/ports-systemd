# description	: The core functions you need to create Docker images and run Docker containers
# depends	: containerd runc nftables

pkgname=docker
pkgver=29.1.3
pkgrel=2
_moby_commit=fbf3ed25f893e6ce21336f1101590e40a13934f4
_tini_commit=de40ad007797e0dcd8b7126f27bb87401d224240
url='https://www.docker.com'
source=($pkgname-${pkgver}.tar.gz::https://github.com/moby/moby/archive/docker-v${pkgver}.tar.gz
	https://github.com/docker/cli/archive/v${pkgver}/cli-${pkgver}.tar.gz
	tini-$_tini_commit.tar.gz::https://github.com/krallin/tini/archive/$_tini_commit.tar.gz
	$pkgname.hooks docker.init )



# create a fake go path directory and pushd into it
# $1 real directory
# $2 gopath directory
_fake_gopath_pushd() {
  mkdir -p "$GOPATH/src/${2%/*}"
  rm -f "$GOPATH/src/$2"
  ln -rsT "$1" "$GOPATH/src/$2"
  pushd  "$GOPATH/src/$2" >/dev/null
}

_fake_gopath_popd() {
  popd >/dev/null
}

build() {
    ln -sf moby-docker-v${pkgver} moby
	echo 'Checking commit mismatch'
	(
	local _cfile
	for _cfile in tini; do
		. "moby/hack/dockerfile/install/$_cfile.installer"
	done
	local _commit _pkgbuild _dockerfile
	err=0
	return $err
	)

	### globals
	export GOPATH="$srcdir"
	export PATH="$GOPATH/bin:$PATH"
	export CGO_CPPFLAGS="${CPPFLAGS}"
	export CGO_CFLAGS="${CFLAGS}"
	export CGO_CXXFLAGS="${CXXFLAGS}"
	export CGO_LDFLAGS="${LDFLAGS}"
	export LDFLAGS=''
	export GOFLAGS='-buildmode=pie -trimpath -mod=readonly -modcacherw -ldflags=-linkmode=external -ldflags=-compressdwarf=false -ldflags=-B=gobuildid'
	export GO111MODULE=off
	export DISABLE_WARN_OUTSIDE_CONTAINER=1

	### cli
	echo 'Building cli'
	_fake_gopath_pushd cli-$pkgver  github.com/docker/cli
	make VERSION=$pkgver dynbinary
	make manpages
	_fake_gopath_popd

	### daemon
	echo 'Building daemon'
	_fake_gopath_pushd moby github.com/moby/moby/v2
		DOCKER_GITCOMMIT=$_moby_commit \
		VERSION=$pkgver \
		hack/make.sh dynbinary
	_fake_gopath_popd

	### docker-init
	echo 'Building docker-init'
	_fake_gopath_pushd tini-$_tini_commit github.com/krallin/tini
	cmake -DCMAKE_POLICY_VERSION_MINIMUM=3.5 .
	# we must use the static binary because it's started in a foreign os
	make tini-static
	_fake_gopath_popd


	### init
	install -Dm755 tini-$_tini_commit/tini-static "$pkgdir/usr/bin/docker-init"
	### dockerd
	install -Dm755 moby/bundles/dynbinary-daemon/dockerd "$pkgdir"/usr/bin/dockerd
	install -Dm755 moby/bundles/dynbinary-daemon/docker-proxy "$pkgdir/usr/bin/docker-proxy"
	### cli
	cd "$srcdir"/cli-$pkgver
	# binary
	install -Dm755 build/docker "$pkgdir/usr/bin/docker"
	# completion (see FS#79067)
	install -Dm644 <(build/docker completion bash) "$pkgdir/usr/share/bash-completion/completions/docker"
	install -Dm644 <(build/docker completion zsh) "$pkgdir/usr/share/zsh/site-functions/_docker"
	install -Dm644 <(build/docker completion fish) "$pkgdir/usr/share/fish/vendor_completions.d/docker.fish"
	# man
	install -dm755 "$pkgdir/usr/share/man"
	cp -r man/man* "$pkgdir/usr/share/man"

	install -Dm755 "$srcdir"/$pkgname.hooks "$pkgdir"/usr/share/blfs-bootscripts/hooks/$pkgname.hooks

	install -Dm 0754 "$srcdir"/docker.init "$pkgdir"/etc/rc.d/init.d/docker

    for i in 0 1 2 3 4 5 6; do
        install -d "$pkgdir"/etc/rc.d/rc$i.d
        case $i in
            0|1|6) ln -sf ../init.d/docker "$pkgdir"/etc/rc.d/rc$i.d/K30docker ;;
            *) ln -sf ../init.d/docker "$pkgdir"/etc/rc.d/rc$i.d/S70docker ;;
        esac
    done
}
