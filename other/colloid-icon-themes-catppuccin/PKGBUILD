# description	: Colloid Icon Theme
# depends	: gtk3 hicolor-icon-theme

pkgname=colloid-icon-themes-catppuccin
pkgver=2025.07.19
_pkgver="${pkgver//./-}"
pkgrel=1
options=(!strip)
url='https://github.com/vinceliuice/Colloid-icon-theme'
source=(colloid-icon-themes-$pkgver.tar.gz::https://github.com/vinceliuice/Colloid-icon-theme/archive/refs/tags/$_pkgver.tar.gz)

build() {
    cd Colloid-icon-theme-$_pkgver

    # Disable running gtk-update-icon-cache
    sed -i '/gtk-update-icon-cache/d' install.sh

    ./install.sh -s catppuccin -t all -d "$pkgdir/usr/share/icons"

    find  "$pkgdir" -xtype l -delete
}
