# description	: Operating system and container binary deployment and upgrades
# depends	: xz glib fuse zlib libarchive curl gpgme libgpg-error
# depends	: grub gobject-introspection util-linux libsoup3 openssl
# depends	: dbus avahi

pkgname=ostree
pkgver=2025.6
pkgrel=1
source=(https://github.com/ostreedev/ostree/releases/download/v$pkgver/libostree-$pkgver.tar.xz
		ostree-2024.8-Werror.patch)

build() {
    cd libostree-$pkgver

	patch -Np1 -i ../ostree-2024.8-Werror.patch

	libtoolize --force \
			&& aclocal -I m4 \
			&& autoconf \
			&& automake --add-missing

    ./configure \
        --prefix=/usr \
        --enable-shared \
		--with-grub2-mkconfig-path=grub-mkconfig \
        --with-modern-grub \
        --with-libarchive \
        --with-curl \
        --enable-introspection=yes \
        --disable-gtk-doc \
        --with-gpgme \
        --with-http2 \
        --without-selinux \
        --with-soup3 \
        --without-soup \
        --with-libmount \
        --with-crypto=openssl \
        --without-ed25519-libsodium \
		--without-avahi \
		--with-systemd \
        --docdir=/usr/share/doc/$pkgname-$pkgver
    make
    make DESTDIR="$pkgdir" install
}
