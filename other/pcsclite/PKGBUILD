# description	: PC/SC Architecture smartcard middleware library
# depends	: glibc polkit python meson systemd

pkgname=pcsclite
pkgver=2.4.0
pkgrel=2
url='https://pcsclite.apdu.fr'
source=($pkgname-$pkgver.tar.gz::https://github.com/LudovicRousseau/PCSC/archive/refs/tags/$pkgver.tar.gz
        $pkgname.hooks)

build() {
	cd PCSC-$pkgver

    meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D libsystemd=true \
        -D libudev=true \
        -D polkit=true \
        -D serial=true \
        build
    ninja -C build
    DESTDIR="$pkgdir" ninja install -C build

    install -d "$pkgdir/usr/lib/pcsc/drivers"

    install -Dm755 "$srcdir"/$pkgname.hooks "$pkgdir"/usr/share/blfs-bootscripts/hooks/$pkgname.hooks
}
