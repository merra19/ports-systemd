# description	: GNOME default icon theme
# depends	: gtk3 librsvg

pkgname=adwaita-icon-theme
pkgver=49.0
pkgrel=1
url='https://gitlab.gnome.org/GNOME/adwaita-icon-theme'
source=(https://download.gnome.org/sources/adwaita-icon-theme/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        build
	ninja -C build
    DESTDIR="$pkgdir" ninja install -C build
}
