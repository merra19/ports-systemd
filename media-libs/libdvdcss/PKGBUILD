# description	: A portable abstraction library for DVD decryption
# depends	: glibc

pkgname=libdvdcss
pkgver=1.5.0
pkgrel=1
url='https://www.videolan.org/developers/libdvdcss.html'
source=(https://get.videolan.org/libdvdcss/$pkgver/$pkgname-$pkgver.tar.bz2)

build() {
	cd $pkgname-$pkgver

    # First, install the documentation in a versioned directory
    sed -i "/get_option/s/libdvdnav/&-$pkgver/" meson.build
	
    meson setup \
        --prefix=/usr \
        --buildtype=plain \
        build 
    ninja -C build
    DESTDIR="$pkgdir" ninja install -C build
    rm -fv "$pkgdir"/usr/lib/libdvdcss.a
}
