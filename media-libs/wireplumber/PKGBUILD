# description	: Replacement for pipewire-media-session
# depends	: pipewire glib elogind lua py3-lxml py3-sphinx_rtd_theme

pkgname=wireplumber
pkgver=0.5.10
pkgrel=2
url='https://gitlab.freedesktop.org/pipewire/wireplumber'
source=(https://gitlab.freedesktop.org/pipewire/wireplumber/-/archive/$pkgver/$pkgname-$pkgver.tar.bz2
		pipewire-launcher.sh pipewire.desktop)

build() {
	cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D system-lua=true \
        build
	ninja -C build
	DESTDIR="$pkgdir" ninja install -C build

    mv -v "$pkgdir"/usr/share/doc/wireplumber{,-$pkgver}

    install -Dm755 "$srcdir"/pipewire-launcher.sh "$pkgdir"/usr/bin/pipewire-launcher.sh
    install -Dm644 "$srcdir"/pipewire.desktop "$pkgdir"/etc/xdg/autostart/pipewire.desktop
}
