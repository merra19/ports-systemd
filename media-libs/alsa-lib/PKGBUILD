# description	: Advanced Linux Sound Architecture Library
# depends	: glibc alsa-ucm-conf alsa-topology-conf elogind

pkgname=alsa-lib
pkgver=1.2.15.1
pkgrel=1
options=(!lto)
url='https://alsa-project.org/wiki/Main_Page'
source=(https://www.alsa-project.org/files/pub/lib/$pkgname-$pkgver.tar.bz2)

build() {
	cd $pkgname-$pkgver

    ./configure \
        --prefix=/usr
	make
    make DESTDIR="$pkgdir" install
}
