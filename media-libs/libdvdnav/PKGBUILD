# description	: Library for DVD navigation tools
# depends	: libdvdread

pkgname=libdvdnav
pkgver=7.0.0
pkgrel=1
url='https://www.videolan.org/developers/libdvdnav.html'
source=(https://get.videolan.org/libdvdnav/$pkgver/$pkgname-$pkgver.tar.bz2)

build() {
	cd $pkgname-$pkgver

    # First, install the documentation in a versioned directory
    sed -i "/get_option/s/libdvdnav/&-$pkgver/" meson.build
	
    meson setup \
        --prefix=/usr \
        --buildtype=plain \
        build 
    ninja -C build
    DESTDIR="$pkgdir" ninja install -C build
    rm -fv "$pkgdir"/usr/lib/libdvdnav.a
}
