# description	: Standard GNU compressor
# depends	: glibc less

pkgname=gzip
pkgver=1.14
pkgrel=1
url='https://www.gnu.org/software/gzip'
source=(https://mirror.lyrahosting.com/gnu/gzip/$pkgname-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver

    ./configure \
        --prefix=/usr
    make
    make DESTDIR="$pkgdir" install
}
