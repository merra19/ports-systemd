#!/bin/bash

# vars
BUILD_SCRIPT="PKGBUILD"
PKGDB_DIR="/var/lib/scratchpkg/db"
PKGDBPERMS_DIR="${PKGDB_DIR}.perms"
WORLD_FILE="$(dirname $PKGDB_DIR)/world" 
REPO_FILE="${REPO_FILE:-/etc/scratchpkg.repo}"
MASK_FILE="${MASK_FILE:-/etc/scratchpkg.mask}"
CONFIG_FILE="${CONFIG_FILE:-/etc/scratchpkg.conf}"
ALIAS_FILE="${ALIAS_FILE:-/etc/scratchpkg.alias}"
# check alias port
[ "$(grep -Ev '^#' $ALIAS_FILE)" ] && ALIAS_PORT="yes" || ALIAS_PORT="no"

# default value from pkgbuild
SOURCE_DIR="/var/cache/scratchpkg/sources"
PACKAGE_DIR="/var/cache/scratchpkg/packages"
WORK_DIR="/var/cache/scratchpkg/work"
CURL_OPTS=""
COMPRESSION_MODE="xz"
NO_STRIP="no"
IGNORE_CHECKSUM="no"
KEEP_LIBTOOL="no"
KEEP_LOCALE="no"
KEEP_DOC="no"
NOCOLOR="no"

# apply scratchpkg.conf
. "$CONFIG_FILE"


TASKETCMD="taskset -c $CPULIST "

if [ "$NOCOLOR" = "no" ]; then
	RED='\033[31m'
	GREEN='\033[32m'
	YELLOW='\033[33m'
	CYAN='\033[36m'
	PURPLE='\033[35m'
	CRESET='\033[0m'
else
	RED=
	GREEN=
	YELLOW=
	CYAN=
	PURPLE=
	CRESET=
fi

check_depsopt() {
	local i
	list="$1"
	func=""
	for i in $list;do
		case $i in
		*!!*)  name1="${i%!!*}"; name2=${i#*!!};;
		*) name1=$i ; name2=$i ;;
		esac
		if echo $OPT_DEPLISTS | grep -w -q $name1;then
			func="$func $name2" 
		fi
	done
	echo $func
}

needroot() {	
	[ "$(id -u)" = 0 ] || {
		msgerr "this operation need root access!"
		exit 1
	}
}

msg() {
	printf "${GREEN}==>${CRESET} %s\n" "$1"
}

msginst() {
	printf "[${GREEN}i${CRESET}] %s\n" "$1"
}

msgmiss() {
	printf "[${YELLOW}m${CRESET}] %s\n" "$1"
}

msgnoinst() {
	printf "[-] %s\n" "$1"
}

msgerr() {
	printf "${RED}ERROR:${CRESET} %s\n" "$1" >&2
}

msgwarn() {
	printf "${YELLOW}WARNING:${CRESET} %s\n" "$1" >&2
}

msg_portnotfound() {
	printf "%s\n" "Port '$1' not found."
}

msg_portnotinstalled() {
	printf "%s\n" "Port '$1' not installed."
}

msg_portalreadyinstalled() {
	printf "%s\n" "Port '$1' already installed."
}

msg_depsstatus() {
	for i in $@; do
		if scratch_isinstalled $i; then
			msginst "$i"
		elif getportpath $i >/dev/null; then
			msgnoinst "$i"
		else
			msgmiss "$i"
		fi
	done
	unset i
}

getportpath() {	
	for repo in $PORT_REPO; do
		if [ -f "$repo/$1/$BUILD_SCRIPT" ]; then
			dirname "$repo/$1/$BUILD_SCRIPT"
			return 0
		fi
	done
	return 1	
}

get_iversion() {
	awk 'NR==1 {print $1}' $PKGDB_DIR/$1 2>/dev/null
}

get_irelease() {
	awk 'NR==1 {print $2}' $PKGDB_DIR/$1 2>/dev/null
}

get_version() {
	p=$(getportpath $1)
	[ "$p" ] && . $p/$BUILD_SCRIPT || pkgver=0
	printf "%s\n" "$pkgver"
}

get_release() {
	p=$(getportpath $1)
	[ "$p" ] && . $p/$BUILD_SCRIPT || pkgrel=0
	printf "%s\n" "$pkgrel"
}

allinstalled() {	
	for i in $PKGDB_DIR/*; do
		printf "%s\n" "${i##*/}"
	done
}

vercomp() {	
	if [ "$1" = "$2" ]; then
		return 0 # same version
	elif [ "$1" = "$(echo "$1\n$2" | sort -V | head -n1)" ]; then
		return 1 # $1 lower than $2
	else
		return 2 # $1 higher than $2
	fi
}

deps_alias() {
	for d in $deps ; do
		[ "$(grep -w ^$d $ALIAS_FILE)" ] && \
		echo "$(grep -w ^$d $ALIAS_FILE | awk '{print $2}')" || \
		echo "$d"
	done
}

get_depends() {
	ppath=$(getportpath $1) || return 0
	deps=$(awk -F':' '/depends/{print $2}' $ppath/$BUILD_SCRIPT | tr ' ' '\n' | awk '!a[$0]++')
    optz=$(awk -F':' '/optional/{print $2}' $ppath/$BUILD_SCRIPT | tr ' ' '\n' | awk '!a[$0]++')
    listdeps=$(check_depsopt "$optz")
    deps="$deps $listdeps"
	[ "$ALIAS_PORT" = "yes" ] && deps_alias $deps || echo $deps
}

confirm() {
	printf "$1 (Y/n) "
	read -r response
	case "$response" in
		[Nn][Oo]|[Nn]) echo "$2"; return 2 ;;
		*) : ;;
	esac
	return 0
}

checktool() {	
	if ! command -v $1 >/dev/null; then
		msgerr "'$1' not exist in your system!"
		exit 1
	fi	
}

needarg() {
	[ "$*" ] || {
		echo "This operation required an arguments!"
		exit 1
	}
}

settermtitle() {
	printf "\033]0;$*\a"
}

scratch_build() {
	while [ "$1" ]; do
		case $1 in
			-i|-u|-r|-g|-p) ;;
			--log) LOG=1;;
			-*) OPTS="$OPTS $1";;
			 *) PKGNAME="$PKGNAME $1";;
		esac
		shift
	done
	[ "$PKGNAME" ] || {
		echo "Please specify package(s) to build."
		return 1
	}
	for pkg in $PKGNAME; do
		ppath=$(getportpath $pkg) || {
			msg_portnotfound $pkg
			return 1
		}
		cd $ppath
		settermtitle "Building $pkg..."
		if [ "$LOG" ]; then
			pkgbuild $OPTS | tee /var/log/$pkg-$(get_version $pkg)-$(get_release $pkg)-build-$(date +%Y-%m-%d-%H:%M).log || {
				settermtitle "Building $pkg failed."
				return 1
			}
		else
			pkgbuild $OPTS || {
				settermtitle "Building $pkg failed."
				return 1
			}
		fi
		settermtitle "Building $pkg done."
		cd - >/dev/null
	done
}

scratch_cache() {
	needroot "Clear old caches"
	
	allcachepkg=/tmp/.allcachepkg.$$
	allcachesrc=/tmp/.allcachesrc.$$
	keepcachepkg=/tmp/.keepcachepkg.$$
	keepcachesrc=/tmp/.keepcachesrc.$$
	diffcachepkg=/tmp/.diffcachepkg.$$
	diffcachesrc=/tmp/.diffcachesrc.$$

	touch $allcachepkg $allcachesrc $keepcachepkg $keepcachesrc $diffcachepkg $diffcachesrc

	find "$PACKAGE_DIR" -type f -exec basename {} \; > "$allcachepkg"
    find "$SOURCE_DIR" -type f -exec basename {} \; > "$allcachesrc"

	find "$PKGDB_DIR" -type f -exec basename {} \; | while read -r port; do
		build_script="$(getportpath "$port")/$BUILD_SCRIPT"
        if [ -f "$build_script" ]; then
			. "$build_script"
			echo "$pkgname-$pkgver-$pkgrel.spkg.tar.$COMPRESSION_MODE" >> "$keepcachepkg"
			if [ "$source" ]; then
				for src in ${source[@]}; do
					case $src in
					git+*) sourcename=$(echo "${src#git+}" | xargs basename | cut -d. -f1) ;;
						*::*) sourcename="${src%%::*}";;
						*) sourcename="${src##*/}";;
					esac
					echo "$sourcename" >> "$keepcachesrc"
				done
			fi
		else
			msgerr "$port archived, remove it."
			exit 1
		fi
	done
	
	grep -Fxv -f "$keepcachepkg" "$allcachepkg" > "$diffcachepkg"
	grep -Fxv -f "$keepcachesrc" "$allcachesrc" > "$diffcachesrc"

	cat $diffcachepkg $diffcachesrc
	
	cd "$PACKAGE_DIR"
	sizepkg=$( [ -s "$diffcachepkg" ] && du -ch $(cat "$diffcachepkg") | grep total | awk '{print $1}' || echo "0M")

	cd "$SOURCE_DIR"
	sizesrc=$( [ -s "$diffcachesrc" ] && du -ch $(cat "$diffcachesrc") | grep total | awk '{print $1}' || echo "0M")
	
	echo "Total package cache size: $sizepkg"
	echo "Total sources cache size : $sizesrc"
	
	if [ -s "$diffcachepkg" ] || [ -s "$diffcachesrc" ]; then
		echo
		confirm "Remove old caches?" "Old caches is kept." && {
			for i in $(cat $diffcachepkg); do rm -f "$PACKAGE_DIR/$i"; done
			for i in $(cat $diffcachesrc); do rm -f "$SOURCE_DIR/$i"; done
			msg "Old caches removed!"
		}
	fi
	
	rm -f "$allcachepkg" "$allcachesrc" "$keepcachepkg" "$keepcachesrc" "$diffcachepkg" "$diffcachesrc"
}

scratch_cat() {	
	needarg $@
	if PPATH=$(getportpath "$1"); then
		cat "$PPATH/$BUILD_SCRIPT"
	else
