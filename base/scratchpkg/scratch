scratch_info() {
	needarg "$@"
	ppath=$(getportpath "$1") || {
		msg_portnotfound "$1"
		return 1
	}
	
	. "$ppath/$BUILD_SCRIPT"
	desc=$(awk -F':' '/description/{print $2}' "$ppath/$BUILD_SCRIPT")
	maint=$(awk -F':' '/maintainer/{print $2}' "$ppath/$BUILD_SCRIPT")
	homep="$url"
	deps=$(get_depends "$1" | tr '\n' ' ')

	printf "%s\n" "Name:         $1"
	printf "%s\n" "Path:         $ppath"
	printf "%s\n" "Version:      $pkgver"
	printf "%s\n" "Release:      $pkgrel"
	[ "$commit" ] && printf "%s\n" "Commit:       $commit"
	printf "%s\n" "Description: $desc"
	printf "%s\n" "Maintainer:  $maint"
	printf "%s\n" "Homepage:    $homep"
	printf "%s\n" "Depends:     $deps"
	printf "%s\n" "Installed:    $(get_iversion "$1")-$(get_irelease "$1")"
}

