    # texinfo
    rm -f /usr/share/info/dir
    find /usr/share/info \( -name "*.info" -o -name "*.info.gz" \) -exec install-info {} /usr/share/info/dir \;

    if [ -f /usr/share/blfs-bootscripts/system-hooks.sh ] ;then
        sh /usr/share/blfs-bootscripts/system-hooks.sh
    fi 

    if ls /usr/share/blfs-bootscripts/hooks/*.hooks 1> /dev/null 2>&1; then
        for i in /usr/share/blfs-bootscripts/hooks/*.hooks;do
            sh $i
        done
    fi
}

