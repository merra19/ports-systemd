scratch_dependent() {
	needarg "$@"
	if [ "$(getportpath "$1")" ]; then
		for dpd in $(grep -R "^#.*depends.*:" $PORT_REPO \
			| sed "s/^#.*depends.*:/#|/g;s/ /|/g;s/$/|/g" \
			| grep "|$1|" \
			| awk -F'/' '{print $(NF-1)}' \
			| sort -u); do
			msg_depsstatus "$dpd"
		done
