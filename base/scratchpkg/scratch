run_postinstallsh() {
	# if using -o (download only), dont run post-install.sh script
	if [ ! "$DOWNLOAD_ONLY" ]; then
		[ -f ./post-install.sh ] && {
            sh ./post-install.sh postinst

        if [ $? != 0 ]; then
            msgerr "postinstallsh failed: $pkgname-$pkgver-$pkgrel"
            exit 1
        fi
        }
    fi
}

