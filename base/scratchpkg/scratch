#!/bin/bash

# vars
BUILD_SCRIPT="PKGBUILD"
PKGDB_DIR="/var/lib/scratchpkg/db"
WORLD_FILE="$(dirname "$PKGDB_DIR")/world" 
REPO_FILE="${REPO_FILE:-/etc/scratchpkg.repo}"
MASK_FILE="${MASK_FILE:-/etc/scratchpkg.mask}"
CONFIG_FILE="${CONFIG_FILE:-/etc/scratchpkg.conf}"
ALIAS_FILE="${ALIAS_FILE:-/etc/scratchpkg.alias}"
# check alias port
[ "$(grep -Ev '^#' "$ALIAS_FILE")" ] && ALIAS_PORT="yes" || ALIAS_PORT="no"

# default value from pkgbuild
SOURCE_DIR="/var/cache/scratchpkg/sources"
PACKAGE_DIR="/var/cache/scratchpkg/packages"
WORK_DIR="/var/cache/scratchpkg/work"
CURL_OPTS=""
COMPRESSION_MODE="xz"
NO_STRIP="no"
IGNORE_CHECKSUM="no"
KEEP_LIBTOOL="no"
KEEP_LOCALE="no"
KEEP_DOC="no"
NOCOLOR="no"

# apply scratchpkg.conf
. "$CONFIG_FILE"


TASKETCMD="taskset -c $CPULIST "

if [ "$NOCOLOR" = "no" ]; then
	RED='\033[31m'
	GREEN='\033[32m'
	YELLOW='\033[33m'
	CYAN='\033[36m'
	PURPLE='\033[35m'
	CRESET='\033[0m'
else
	RED=
	GREEN=
	YELLOW=
	CYAN=
	PURPLE=
	CRESET=
fi

check_depsopt() {
	local i
	list="$1"
	func=""
	for i in $list;do
		case $i in
		*!!*)  name1="${i%!!*}"; name2=${i#*!!};;
		*) name1=$i ; name2=$i ;;
		esac
		if echo $OPT_DEPLISTS | grep -w -q $name1;then
			func="$func $name2" 
		fi
	done
	echo $func
}

needroot() {	
	[ "$(id -u)" = 0 ] || {
		msgerr "this operation need root access!"
		exit 1
	}
}

msg() {
	printf "${GREEN}==>${CRESET} %s\n" "$1"
}

msginst() {
	printf "[${GREEN}i${CRESET}] %s\n" "$1"
}

msgmiss() {
	printf "[${YELLOW}m${CRESET}] %s\n" "$1"
}

msgnoinst() {
	printf "[-] %s\n" "$1"
}

msgerr() {
	printf "${RED}ERROR:${CRESET} %s\n" "$1" >&2
}

msgwarn() {
	printf "${YELLOW}WARNING:${CRESET} %s\n" "$1" >&2
}

msg_portnotfound() {
	printf "%s\n" "Port '$1' not found."
}

msg_portnotinstalled() {
	printf "%s\n" "Port '$1' not installed."
}

msg_portalreadyinstalled() {
	printf "%s\n" "Port '$1' already installed."
}

msg_depsstatus() {
	for i in $@; do
		if scratch_isinstalled "$i"; then
			msginst "$i"
		elif getportpath "$i" >/dev/null; then
			msgnoinst "$i"
		else
			msgmiss "$i"
		fi
	done
	unset i
}

getportpath() {	
	for repo in $PORT_REPO; do
		if [ -f "$repo/$1/$BUILD_SCRIPT" ]; then
			dirname "$repo/$1/$BUILD_SCRIPT"
			return 0
		fi
	done
	return 1	
}

get_iversion() {
	awk 'NR==1 {print $1}' "$PKGDB_DIR/$1" 2>/dev/null
}

get_irelease() {
	awk 'NR==1 {print $2}' "$PKGDB_DIR/$1" 2>/dev/null
}

get_version() {
	p=$(getportpath "$1")
	[ "$p" ] && . "$p/$BUILD_SCRIPT" || pkgver=0
	printf "%s\n" "$pkgver"
}

get_release() {
	p=$(getportpath "$1")
	[ "$p" ] && . "$p/$BUILD_SCRIPT" || pkgrel=0
	printf "%s\n" "$pkgrel"
}

allinstalled() {	
	for i in "$PKGDB_DIR"/*; do
		printf "%s\n" "${i##*/}"
	done
}

vercomp() {	
	if [ "$1" = "$2" ]; then
		return 0 # same version
	elif [ "$1" = "$(printf "%s\n%s\n" "$1" "$2" | sort -V | head -n1)" ]; then
		return 1 # $1 lower than $2
	else
		return 2 # $1 higher than $2
	fi
}

deps_alias() {
	for d in $deps ; do
		[ "$(grep -w "^$d" "$ALIAS_FILE")" ] && \
		printf "%s\n" "$(grep -w "^$d" "$ALIAS_FILE" | awk '{print $2}')" || \
		printf "%s\n" "$d"
	done
}

get_depends() {
	ppath=$(getportpath "$1") || return 0
	deps=$(awk -F':' '/depends/{print $2}' "$ppath/$BUILD_SCRIPT" | tr ' ' '\n' | awk '!a[$0]++')
	optz=$(awk -F':' '/optional/{print $2}' "$ppath/$BUILD_SCRIPT" | tr ' ' '\n' | awk '!a[$0]++')
	listdeps=$(check_depsopt "$optz")
	deps="$deps $listdeps"
	[ "$ALIAS_PORT" = "yes" ] && deps_alias "$deps" || printf "%s\n" "$deps"
}

confirm() {
	printf "%s" "$1 (Y/n) "
	read -r response
	case "$response" in
		[Nn][Oo]|[Nn]) printf "%s\n" "$2"; return 2 ;;
		*) : ;;
	esac
	return 0
}

checktool() {	
	if ! command -v "$1" >/dev/null; then
		msgerr "'$1' not exist in your system!"
		exit 1
	fi	
}

needarg() {
	[ "$*" ] || {
		printf "%s\n" "This operation required an arguments!"
		exit 1
	}
}

settermtitle() {
	printf "\033]0;%s\a" "$*"
}

scratch_build() {
	while [ "$1" ]; do
		case $1 in
			-i|-u|-r|-g|-p) ;;
			--log) LOG=1;;
			-*) OPTS="$OPTS $1";;
			 *) PKGNAME="$PKGNAME $1";;
		esac
		shift
	done
	[ "$PKGNAME" ] || {
		printf "%s\n" "Please specify package(s) to build."
		return 1
	}
	for pkg in $PKGNAME; do
		ppath=$(getportpath "$pkg") || {
			msg_portnotfound "$pkg"
			return 1
		}
		cd "$ppath" || return 1
		settermtitle "Building $pkg..."
		if [ "$LOG" ]; then
			pkgbuild $OPTS | tee "/var/log/$pkg-$(get_version "$pkg")-$(get_release "$pkg")-build-$(date +%Y-%m-%d-%H:%M).log" || {
				settermtitle "Building $pkg failed."
				return 1
			}
		else
			pkgbuild $OPTS || {
				settermtitle "Building $pkg failed."
				return 1
			}
		fi
		settermtitle "Building $pkg done."
		cd - >/dev/null || return 1
	done
}

scratch_cache() {
    needroot "Clear old caches"

    clean_pkg=1
    clean_src=1

    case "${1:-}" in
        "") : ;;  # default: clean both
        -p|--pkg) clean_src=0 ;;
        -s|--src) clean_pkg=0 ;;
        -h|--help)
            cat <<EOF
Usage: scratch cache [pkg|src]

  (no args)   clean packages AND sources cache
  -p, --pkg   clean packages cache only
  -s, --src   clean sources cache only
EOF
            return 0
            ;;
        *)
            msgerr "Invalid argument: $1"
            return 1
            ;;
    esac
    
     # Converts bytes to a human-readable size with one decimal
     human_size() {
        b=$1
        awk -v b="$b" 'BEGIN {
            suf="B K M G T P";
            split(suf,u);
            i=1;
            val=b;
            while(val>=1024 && i<6){ val/=1024; i++ }
            printf "%.1f%s", val, u[i]
        }'
     }  

    # Internal lists (compact with | separator)
    allpkg=""
    allsrc=""
    keeppkg=""
    keepsrc=""

    # Scan package cache
    if [ "$clean_pkg" -eq 1 ]; then
        for f in $(find "$PACKAGE_DIR" -type f 2>/dev/null); do
            file=${f##*/}
            allpkg="${allpkg}${allpkg:+|}$file"
        done
    fi

    # Scan source cache
    if [ "$clean_src" -eq 1 ]; then
        for f in $(find "$SOURCE_DIR" -type f 2>/dev/null); do
            file=${f##*/}
            allsrc="${allsrc}${allsrc:+|}$file"
        done
    fi

    # Scan PKGDB to determine what to keep
    for port in $(find "$PKGDB_DIR" -type f 2>/dev/null); do
        portname=${port##*/}
        build_script="$(getportpath "$portname")/$BUILD_SCRIPT"

        if [ ! -f "$build_script" ]; then
            msgerr "$portname archived, remove it."
            continue
        fi

        . "$build_script"

        # Keep packages
        if [ "$clean_pkg" -eq 1 ]; then
            p="${name}-${version}-${release}.spkg.tar.${COMPRESSION_MODE}"
            keeppkg="${keeppkg}${keeppkg:+|}$p"
        fi

        # Keep sources
        if [ "$clean_src" -eq 1 ] && [ "$source" ]; then
            for s in $source; do
                case $s in
                    *::*) f="${s%%::*}" ;;
                    */*)  f="${s##*/}" ;;
                    *)    f="$s" ;;
                esac
                keepsrc="${keepsrc}${keepsrc:+|}$f"
            done
        fi
    done

    # Diff lists (all - keep)
    diff_lists() {
        all="$1"
        keep="$2"
        out=""
        oldIFS=$IFS
        IFS='|'
        set -- $all
        IFS=$oldIFS
        for f; do
            case "|$keep|" in
                *"|$f|"*) ;;  # keep
                *) out="${out}${out:+|}$f" ;;
            esac
        done
        printf '%s' "$out"
    }

    to_remove_pkg=""
    to_remove_src=""
    [ "$clean_pkg" -eq 1 ] && to_remove_pkg=$(diff_lists "$allpkg" "$keeppkg")
    [ "$clean_src" -eq 1 ] && to_remove_src=$(diff_lists "$allsrc" "$keepsrc")

    # Show files and sizes
    show_list() {
        list="$1"
        dir="$2"
        [ -z "$list" ] && return 0
        
	# Print list, one file per line
        oldIFS=$IFS
        IFS='|'
        set -- $list
        IFS=$oldIFS

        for f; do printf '%s\n' "$f"; done

        # Calculate total size
        total=0
        for f; do
            [ -f "$dir/$f" ] || continue
            sz=$(wc -c <"$dir/$f" 2>/dev/null || printf "0\n")
            total=$((total + sz))
        done

        printf "Total size %s: %s\n\n" "${dir##*/}" "$(human_size "$total")"
    }

    show_list "$to_remove_pkg" "$PACKAGE_DIR"
    show_list "$to_remove_src" "$SOURCE_DIR"

    # Nothing to remove?
    if [ -z "$to_remove_pkg" ] && [ -z "$to_remove_src" ]; then
        msg "Cache is already clean."
        return 0
    fi

    # Confirm deletion
    if confirm "Remove old caches?" "Old caches are kept."; then
        # delete in parallel
        [ -n "$to_remove_pkg" ] && \
        printf '%s' "$to_remove_pkg" | tr '|' '\n' | xargs -P 4 -I{} rm -f "$PACKAGE_DIR/{}"

        [ -n "$to_remove_src" ] && \
        printf '%s' "$to_remove_src" | tr '|' '\n' | xargs -P 4 -I{} rm -f "$SOURCE_DIR/{}"
  
	msg "Old caches removed!"
    fi
}

