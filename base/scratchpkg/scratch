			WILLINSTALL="$WILLINSTALL $dd"
			UPGPKG=$(( UPGPKG + 1 ))
		done
	fi
	echo $installmsg | tr ' ' '\n' | tr '#' ' ' | column -t
	echo
	echo "( $UPGPKG upgrade, $NEWPKG new install )"
