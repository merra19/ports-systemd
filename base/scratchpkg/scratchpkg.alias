#
# /etc/scratchpkg.alias : scratchpkg alias file
#
# format:
#    <real package> <aliased package>
#
# example:
#    openssl libressl
#

xorg-server xlibre-xserver
xf86-input-evdev xlibre-xf86-input-evdev
xf86-input-libinput xlibre-xf86-input-libinput
xf86-video-amdgpu xlibre-xf86-video-amdgpu
xf86-video-ati xlibre-xf86-video-ati
