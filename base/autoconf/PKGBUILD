# description	: Used to create autoconfiguration files
# depends	: m4 perl

pkgname=autoconf
pkgver=2.72
pkgrel=1
url='https://www.gnu.org/software/autoconf/autoconf.html'
source=(https://mirror.lyrahosting.com/gnu/autoconf/$pkgname-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver

    ./configure \
        --prefix=/usr
    make
    make DESTDIR="$pkgdir" install
}
