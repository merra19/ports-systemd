# description	: QEMU + Kernel-based Virtual Machine userland tools
# depends	: glib pixman alsa-lib dtc libslirp sdl2-compat pipewire
# depends	: curl fuse gnutls gtk3 keyutils libaio libusb libgcrypt
# depends	: libjpeg-turbo libseccomp libssh2 libpng libtasn1 pam
# depends	: lzo nettle mesa vte py3-sphinx_rtd_theme bluez

pkgname=qemu
pkgver=10.2.0
pkgrel=1
url='https://www.qemu.org'
source=(https://download.qemu.org/$pkgname-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver

	QEMU_ARCH=x86_64-softmmu

	mkdir -vp build &&
	cd        build &&

	../configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--target-list=$QEMU_ARCH \
		--audio-drv-list=alsa \
		--disable-pa \
		--enable-slirp \
		--docdir=/usr/share/doc/qemu-10.0.3 &&

	unset QEMU_ARCH &&

	make
    make DESTDIR="$pkgdir" install

	ln -sv qemu-system-`uname -m` "$pkgdir"/usr/bin/qemu
}
