# description	: Cross-distro effort for providing metadata for software in the Linux ecosystem
# depends	: zstd libxml2 libxmlb libyaml snowball-stemmer curl 
# depends	: qt6 libxslt itstool py3-gi-docgen elogind

pkgname=dinit
pkgver=0.19.3
pkgrel=1
options=(!lto)
url='https://www.freedesktop.org/wiki/Distributions/AppStream'
source=($pkgname-$pkgver.tar.gz::https://github.com/davmac314/dinit/archive/refs/tags/v$pkgver.tar.gz
		dinit.init)

build() {
	cd $pkgname-$pkgver

	make
	make DESTDIR="$pkgdir" SBINDIR=/usr/sbin BUILD_SHUTDOWN=no install

	install -Dm 0754 "$srcdir"/dinit.init "$pkgdir"/etc/rc.d/init.d/dinit

    for i in 0 1 2 3 4 5 6; do
        install -d "$pkgdir"/etc/rc.d/rc$i.d
        case $i in
            0|1|6) ln -sf ../init.d/dinit "$pkgdir"/etc/rc.d/rc$i.d/K80dinit ;;
            *) ln -sf ../init.d/dinit "$pkgdir"/etc/rc.d/rc$i.d/S12dinit ;;
        esac
    done
}
