# description	: A validating, recursive and caching DNS resolver
# depends	: libevent nettle protobuf-c swig openssl nghttp2
# depends	: expat python py3-sphinx

pkgname=unbound
pkgver=1.23.1
pkgrel=1
url='https://unbound.net'
source=(https://nlnetlabs.nl/downloads/unbound/$pkgname-$pkgver.tar.gz
		named.root #  https://www.internic.net/domain/named.root
		unbound.conf
        $pkgname.hooks unbound)
backup=(etc/unbound/unbound.conf)

 build() {
	cd $pkgname-$pkgver
  
	PYTHON_VERSION=3.13 \
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--disable-static \
		--with-libevent \
		--with-pyunbound \
		--with-pidfile=/run/unbound.pid
	make
    make DESTDIR="$pkgdir" install

	mkdir -p "$pkgdir"/usr/bin/
	mv -v "$pkgdir"/usr/sbin/unbound-host "$pkgdir"/usr/bin/

	mv "$pkgdir"/etc/unbound/unbound.conf "$pkgdir"/etc/unbound/unbound.conf.back

	install -Dm755 "$srcdir"/$pkgname.hooks "$pkgdir"/usr/share/blfs-bootscripts/hooks/$pkgname.hooks
	install -Dm644 "$srcdir"/named.root "$pkgdir"/etc/unbound/root.hints
	install -Dm644 "$srcdir"/unbound.conf "$pkgdir"/etc/unbound/unbound.conf

	chown -R unbound "$pkgdir"/etc/unbound

	install -Dm 0754 "$srcdir"/unbound "$pkgdir"/etc/rc.d/init.d/unbound

    for i in 0 1 2 3 4 5 6; do
        install -d "$pkgdir"/etc/rc.d/rc$i.d
        case $i in
            0|1|6) ln -sf ../init.d/unbound "$pkgdir"/etc/rc.d/rc$i.d/K79unbound ;;
            *) ln -sf ../init.d/unbound "$pkgdir"/etc/rc.d/rc$i.d/S21unbound ;;
        esac
    done
}
