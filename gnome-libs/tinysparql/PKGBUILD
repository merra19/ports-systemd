# description	: Low-footprint RDF triple store with SPARQL 1.1 interface
# depends	: json-glib vala libsoup3 gobject-introspection icu sqlite
# depends	: py3-gi-docgen py3-gobject py3-asciidoc avahi
# depends	: graphviz bash-completion snowball-stemmer

pkgname=tinysparql
pkgver=3.10.1
pkgrel=1
url='https://gnome.pages.gitlab.gnome.org/tinysparql'
source=(https://download.gnome.org/sources/tinysparql/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

    # Fix the location to install the documentation into
    sed -e "s/'generate'/&, '--no-namespace-dir'/"         \
        -e "/--output-dir/s/@OUTPUT@/&\/tinysparql-$pkgver/" \
        -i docs/reference/meson.build

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D man=true \
        -D systemd_user_services=false  \
        build
	ninja -C build
    DESTDIR="$pkgdir" ninja install -C build
}
