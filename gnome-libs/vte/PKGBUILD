# description	: Library providing a virtual terminal emulator widget
# depends	: glib icu pango pcre2 gtk3 zlib lz4 libxml2 gtk4 systemd
# depends	: gobject-introspection vala gnutls fast_float simdutf
# depends	: py3-gi-docgen fmt

pkgname=vte
pkgver=0.82.2
pkgrel=1
url='https://gitlab.gnome.org/GNOME/vte'
source=(https://gitlab.gnome.org/GNOME/vte/-/archive/$pkgver/$pkgname-$pkgver.tar.gz
        defaults.patch)

build() {
    cd $pkgname-$pkgver

    patch -Np1 -i ../defaults.patch

    export CFLAGS="${CFLAGS} -fexceptions "
    export CXXFLAGS="${CFLAGS} -fexceptions "

	sed -e "/docdir =/s@\$@/ 'vte-$pkgver'@" \
    	-i doc/reference/meson.build

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D fribidi=false \
		-D docs=true \
        build
	ninja -C build
	DESTDIR="$pkgdir" ninja install -C build

    rm -v "$pkgdir"/etc/profile.d/vte.*
}
