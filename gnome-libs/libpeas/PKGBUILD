# description	: A GObject plugins library
# depends	: glib gobject-introspection lua py3-gobject gtk3 libxml2
# depends	: py3-gi-docgen

pkgname=libpeas
pkgver=1.36.0
pkgrel=2
url='https://gitlab.gnome.org/GNOME/libpeas'
source=(https://download.gnome.org/sources/libpeas/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	sed "/docs_dir =/s@\$@/ 'libpeas-$pkgver.0'@" \
    	-i docs/reference/meson.build

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        --wrap-mode=nofallback \
		-D gtk_doc=true  \
		-D vapi=true \
        build
	ninja -C build
    DESTDIR="$pkgdir" ninja install -C build
}