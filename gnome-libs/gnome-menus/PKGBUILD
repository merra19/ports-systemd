# description	: Library and layout configuration for the Desktop Menu fd.o specification
# depends	: glib gobject-introspection

pkgname=gnome-menus
pkgver=3.36.0
pkgrel=1
url='https://gitlab.gnome.org/GNOME/gnome-menus'
source=(https://download.gnome.org/sources/$pkgname/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-static
    make
    make DESTDIR="$pkgdir" install
}
