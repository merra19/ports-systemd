# description	: GObject library for accessing the freedesktop.org Secret Service API
# depends	: glib libgcrypt gobject-introspection vala py3-gi-docgen
# depends	: docbook-xml docbook-xsl-nons libxslt

pkgname=libsecret
pkgver=0.21.7
pkgrel=2
url='https://gnome.pages.gitlab.gnome.org/libsecret'
source=(https://download.gnome.org/sources/libsecret/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	sed "s/api_version_major/'$pkgver'/" \
    	-i docs/reference/libsecret/meson.build

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D gtk_doc=true \
        build
	ninja -C build
    DESTDIR="$pkgdir" ninja install -C build

    # conflict bash-completion
    rm -rf "$pkgdir"/usr/share/bash-completion/completions/secret-tool
}
