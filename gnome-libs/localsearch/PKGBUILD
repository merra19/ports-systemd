# description	: Indexer and search engine that powers desktop search for core GNOME components
# depends	: gexiv2 gst-plugins-base tinysparql exempi giflib ffmpeg
# depends	: icu libexif libgxps libseccomp poppler upower cmake
# depends	: py3-asciidoc dconf libgsf networkmanager taglib
# depends	: totem-pl-parser

pkgname=localsearch
pkgver=3.9.0
pkgrel=1
url='https://gnome.pages.gitlab.gnome.org/localsearch'
source=(https://download.gnome.org/sources/localsearch/${pkgver%.*}/$pkgname-$pkgver.tar.xz
        https://www.linuxfromscratch.org/patches/blfs/12.4/localsearch-3.9.0-libxml2_2_14-1.patch)

build() {
	cd $pkgname-$pkgver

    # Apply a patch to make the HTML extractor compatible with libxml2-2.14 and later
    patch -Np1 -i ../localsearch-3.9.0-libxml2_2_14-1.patch

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D man=true \
        -D systemd_user_services=false  \
        build
	ninja -C build
    DESTDIR="$pkgdir" ninja install -C build
}
