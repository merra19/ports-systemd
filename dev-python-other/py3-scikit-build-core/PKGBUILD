# description	: Build backend for CMake based projects
# depends	: py3-flit-core py3-gpep517 py3-setuptools freetype
# depends	: py3-packaging py3-pathspec py3-build py3-hatch-vcs
# depends	: py3-hatchling

pkgname=py3-scikit-build-core
pkgver=0.11.6 
pkgrel=1
url='https://github.com/scikit-build/scikit-build-core'
source=($pkgname-$pkgver.tar.gz::https://github.com/scikit-build/scikit-build-core/archive/refs/tags/v$pkgver.tar.gz)

build() {
	cd ${pkgname#*-}-$pkgver

	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d "$pkgdir" .dist/*.whl
}