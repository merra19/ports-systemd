# description	: File transfer program to keep remote files into sync
# depends	: glibc popt xxhash acl perl lz4 openssl zlib zstd python
# depends	: py3-commonmark

pkgname=rsync
pkgver=3.4.1
pkgrel=2
url='https://rsync.samba.org'
options=(!lto)
source=(https://www.samba.org/ftp/rsync/src/$pkgname-$pkgver.tar.gz
		https://www.linuxfromscratch.org/patches/blfs/svn/rsync-3.4.1-security_fix-1.patch
		rsyncd.conf)
backup=(etc/rsyncd.conf)

build() {
    cd $pkgname-$pkgver

	# fix a security vulnerability
	patch -Np1 -i ../rsync-3.4.1-security_fix-1.patch

	./configure \
		--prefix=/usr \
		--enable-xxhash \
		--without-included-zlib
	make
    make DESTDIR="$pkgdir" install

	install -Dm 644 ../rsyncd.conf "$pkgdir"/etc/rsyncd.conf
}