# description	: portmap replacement which supports RPC over various protocols
# depends	: libtirpc

pkgname=rpcbind
pkgver=1.2.8
pkgrel=1
url='https://sourceforge.net/projects/rpcbind'
source=(https://downloads.sourceforge.net/rpcbind/$pkgname-$pkgver.tar.bz2
        rpcbind)

build() {
    cd $pkgname-$pkgver

    # In order to get rpcbind to work properly, first fix the package to use correct service name
    sed -i "/servname/s:rpcbind:sunrpc:" src/rpcbind.c

    ./configure \
        --prefix=/usr \
        --bindir=/usr/sbin \
        --with-rpcuser=root \
        --enable-warmstarts \
		--without-systemdsystemunitdir 
    make
    make DESTDIR="$pkgdir" install

	install -Dm 0754 "$srcdir"/rpcbind "$pkgdir"/etc/rc.d/init.d/rpcbind

    for i in 0 1 2 3 4 5 6; do
        install -d "$pkgdir"/etc/rc.d/rc$i.d
        case $i in
            0|1|6) ln -sf ../init.d/rpcbind "$pkgdir"/etc/rc.d/rc$i.d/K49rpcbind ;;
            *) ln -sf ../init.d/rpcbind "$pkgdir"/etc/rc.d/rc$i.d/S22rpcbind ;;
        esac
    done
}
