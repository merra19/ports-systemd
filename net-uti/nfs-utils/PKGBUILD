# description	: NFS client and server daemons
# depends	: libevent libnl libtirpc libxml2 rpcsvc-proto sqlite
# depends	: libnsl lvm2 libcap pam rpcbind
# optional	: krb5 openldap

pkgname=nfs-utils
pkgver=2.8.3
pkgrel=1
url='http://linux-nfs.org'
source=(https://www.kernel.org/pub/linux/utils/nfs-utils/$pkgver/$pkgname-$pkgver.tar.xz
        nfs-server.conf  0001-Fix-build-with-glibc-2.42.patch nfs-client nfs-server)
backup=(etc/sysconfig/nfs-server)

build() {
    cd $pkgname-$pkgver

    patch -Np1 -i ../0001-Fix-build-with-glibc-2.42.patch

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --sbindir=/usr/sbin \
        --disable-nfsv4 \
        --disable-gss \
        LIBS="-lsqlite3 -levent_core"
    make
    make DESTDIR="$pkgdir" install
    
    mv "$pkgdir"/sbin/* "$pkgdir"/usr/sbin/
    rm -rf "$pkgdir"/sbin

    chmod u+w,go+r "$pkgdir"/usr/sbin/mount.nfs
    chown nobody:nogroup "$pkgdir"/var/lib/nfs

    install -Dm 0644 ../nfs-server.conf "$pkgdir"/etc/sysconfig/nfs-server

	install -Dm 0754 "$srcdir"/nfs-client "$pkgdir"/etc/rc.d/init.d/nfs-client

    for i in 0 1 2 3 4 5 6; do
        install -d "$pkgdir"/etc/rc.d/rc$i.d
        case $i in
            0|1|6) ln -sf ../init.d/nfs-client "$pkgdir"/etc/rc.d/rc$i.d/K48nfs-client ;;
            *) ln -sf ../init.d/nfs-client "$pkgdir"/etc/rc.d/rc$i.d/S24nfs-client ;;
        esac
    done
}
