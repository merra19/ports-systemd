# description	: A JavaScript runtime built on Chrome's V8 JavaScript engine
# depends	: glibc brotli c-ares nghttp2 zlib icu openssl coreutils
# depends	: libuv meson which

pkgname=nodejs
pkgver=22.21.1
pkgrel=1
options=(!lto)
url='https://nodejs.org'
source=(https://nodejs.org/dist/v$pkgver/node-v$pkgver.tar.xz
        https://www.linuxfromscratch.org/patches/blfs/svn/node-v22.21.1-python_build_fix-1.patch)

build() {
	cd node-v$pkgver

    # shrink the build log size from ~104MiB to ~800KiB.
    export CXXFLAGS="$CXXFLAGS -Wno-class-memaccess -Wno-comment -Wno-int-in-bool-context"

    # First, fix building this package with Python 3.14
    patch -Np1 -i ../node-v22.21.1-python_build_fix-1.patch

	./configure \
        --prefix=/usr \
        --shared-brotli \
        --shared-cares \
        --shared-libuv \
        --shared-openssl \
        --shared-nghttp2 \
        --shared-zlib \
        --with-intl=system-icu
	make
    make DESTDIR="$pkgdir" install

    ln -sf node "$pkgdir"/usr/share/doc/node-$pkgver
}
