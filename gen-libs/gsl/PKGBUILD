# description	: The GNU Scientific Library
# depends	: glibc

pkgname=gsl
pkgver=2.8
pkgrel=1
url='https://www.gnu.org/software/gsl'
source=(https://ftp.gnu.org/gnu/gsl/$pkgname-$pkgver.tar.gz)

build() {
	cd $pkgname-$pkgver

	./configure \
		--prefix=/usr \
		--disable-static
	make
	make DESTDIR="$pkgdir" install
}