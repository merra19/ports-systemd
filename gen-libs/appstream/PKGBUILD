# description	: Cross-distro effort for providing metadata for software in the Linux ecosystem
# depends	: zstd libxml2 libxmlb libyaml snowball-stemmer curl 
# depends	: qt6 libxslt itstool py3-gi-docgen

pkgname=appstream
_pkgname=AppStream
pkgver=1.0.6
pkgrel=2
options=(!lto)
url='https://www.freedesktop.org/wiki/Distributions/AppStream'
source=(https://www.freedesktop.org/software/appstream/releases/AppStream-$pkgver.tar.xz
        metainfo)

build() {
	cd ${_pkgname}-$pkgver

	sed -i "/^as_doc_target_dir =/ s/'appstream'/'appstream-$pkgver'/" -i docs/meson.build

    meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D qt=true \
        -D qt-versions=6 \
        -D stemming=true \
        build
    ninja -C build
	DESTDIR="$pkgdir" ninja install -C build

	install -Dm 644 "$srcdir"/metainfo "$pkgdir"/usr/share/metainfo
}
