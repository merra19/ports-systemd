# description	: The GNOME Structured File Library
# depends	: glib gobject-introspection libxml2 zlib bzip2 gtk-doc
# depends	: gdk-pixbuf

pkgname=libgsf
pkgver=1.14.53
pkgrel=2
url='https://gitlab.gnome.org/GNOME/libgsf'
source=(https://download.gnome.org/sources/libgsf/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

    ./configure \
        --prefix=/usr \
        --disable-static \
		--enable-gtk-doc
    make
    make DESTDIR="$pkgdir" install
}
