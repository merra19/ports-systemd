# description	: D-Bus bindings for glib
# depends	: dbus glib expat gtk-doc

pkgname=dbus-glib
pkgver=0.114
pkgrel=2
url='https://dbus.freedesktop.org'
source=(http://dbus.freedesktop.org/releases/$pkgname/$pkgname-$pkgver.tar.gz)

build() {
	cd $pkgname-$pkgver

	./configure \
        --prefix=/usr \
		--sysconfdir=/etc \
		--disable-static \
		--enable-gtk-doc
	make
    make DESTDIR="$pkgdir" install
}
