# description	: Library providing GLib serialization and deserialization for the JSON format
# depends	: glib gobject-introspection py3-gi-docgen py3-docutils
# depends	: gtk-doc

pkgname=json-glib
pkgver=1.10.6
pkgrel=3
options=(!lto)
url='https://wiki.gnome.org/Projects/JsonGlib'
source=(https://download.gnome.org/sources/json-glib/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	sed "/json_docdir =/s|$| / 'json-glib-$pkgver'|" -i doc/meson.build

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
		-D man=true \
		-D documentation=enabled \
        build
	ninja -C build
    DESTDIR="$pkgdir" ninja install -C build
}
