# description	: Typesafe callback system for standard C++
# depends	: libxslt m4 boost docbook-utils docbook-xml

pkgname=libsigc++-3
_pkgname=libsigc++
pkgver=3.6.0
pkgrel=2
url='https://libsigcplusplus.github.io/libsigcplusplus'
source=(https://download.gnome.org/sources/libsigc++/${pkgver%.*}/${_pkgname}-$pkgver.tar.xz)

build() {
	cd ${_pkgname}-$
    
    # First, fix detecting Boost when configuring this package
    sed -i "s/'system',//" meson.build

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        bld
	ninja -C bld
	DESTDIR="$pkgdir" ninja install -C bld
}
