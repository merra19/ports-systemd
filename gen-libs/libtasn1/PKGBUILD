# description	: ASN.1 library
# depends	: glibc help2man bison gtk-doc

pkgname=libtasn1
pkgver=4.20.0
pkgrel=2
options=(!lto)
url='https://www.gnu.org/software/libtasn1'
source=(https://mirror.lyrahosting.com/gnu/libtasn1/$pkgname-$pkgver.tar.gz)

build() {
    cd $pkgname-$pkgver

   ./configure \
        --prefix=/usr \
        --disable-static \
		--enable-gtk-doc 
    CODE_COVERAGE_LDFLAGS=${LDFLAGS} make
    make DESTDIR="$pkgdir" install
}
