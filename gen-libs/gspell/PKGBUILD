# description	: Spell check library for GTK+ applications
# depends	: glib gobject-introspection gtk3 icu meson enchant vala
# depends	: gtk-doc

pkgname=gspell
pkgver=1.14.0
pkgrel=2
url='https://gitlab.gnome.org/GNOME/gspell'
source=(https://download.gnome.org/sources/gspell/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D gtk_doc=true \
        build
	ninja -C build
	DESTDIR="$pkgdir" ninja install -C build
}