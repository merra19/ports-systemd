# description	: Library for handling and rendering XPS documents
# depends	: glibc gtk3 lcms2 libarchive libjpeg-turbo libtiff
# depends	: libxslt gtk-doc

pkgname=libgxps
pkgver=0.3.2
pkgrel=2
url='https://wiki.gnome.org/Projects/libgxps'
source=(https://download.gnome.org/sources/libgxps/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

    meson setup \
        --prefix=/usr \
        --buildtype=release \
		-D enable-gtk-doc=true \
        build
    ninja -C build
    DESTDIR="$pkgdir" ninja install -C build
}
