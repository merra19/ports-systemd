# description	: A sandboxed and extendable image loading framework
# depends	: meson glib gobject-introspection fontconfig bubblewrap
# depends	: lcms2 libseccomp rustc libjxl librsvg vala
# depends	: py3-gi-docgen

pkgname=glycin
pkgver=2.0.7 
pkgrel=1
url='https://gitlab.gnome.org/GNOME/glycin'
source=(https://github.com/harfbuzz/harfbuzz/releases/download/$pkgver/$pkgname-$pkgver.tar.xz)

createpack() {
    mkdir -p vendor
    cargo vendor vendor
    tar -cJpf $pkgname-$pkgver-cargo.tar.xz vendor/
    cp $pkgname-$pkgver-cargo.tar.xz /sources/src/
}

build() {
    cd $pkgname-$pkgver

	if [ ! -f /sources/src/$pkgname-$pkgver-cargo.tar.xz ];then
    	createpack
	else
		tar -xf /sources/src/$pkgname-$pkgver-cargo.tar.xz
	fi

    mkdir -p .cargo
    echo '[source.crates-io]' >> .cargo/config.toml
    echo 'replace-with = "vendored-sources"' >> .cargo/config.toml
    echo '[source.vendored-sources]' >> .cargo/config.toml
    echo 'directory = "vendor"' >> .cargo/config.toml

    sed "/install_dir:.*doc/s|,$| / 'glycin-' + meson.project_version()&|" \
        -i libglycin/meson.build

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D libglycin-gtk4=false \
        -D tests=false \
        -D capi_docs=true \
        build
	ninja -C build
    DESTDIR="$pkgdir" ninja install -C build
}
