# description	: Xfce4 screenshooter application and panel plugin
# depends	: xfce4-panel hicolor-icon-theme wayland-protocols glib
# depends	: xfce4-dev-tools gtk-layer-shell help2man

pkgname=xfce4-screenshooter
pkgver=1.11.3
pkgrel=1
url='https://docs.xfce.org/apps/xfce4-screenshooter/start'
source=(https://archive.xfce.org/src/apps/xfce4-screenshooter/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        --libexecdir=/usr/lib \
        -D x11=enabled \
        -D wayland=enabled \
        -D xfixes=enabled \
        build
	ninja -C build
    DESTDIR="$pkgdir" ninja install -C build
}
